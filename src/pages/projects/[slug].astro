---
export const prerender = true;
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import TiltCards from "../../components/TiltCards.astro";

type ConnectivityPlace = {
  name: string;
  travelTime: string;
  icon: "airport" | "train" | "beach" | "shopping" | "city";
};

type GalleryCategory = {
  label: string;
  description: string;
  images: (string | null)[];
};

type Project = {
  title: string;
  subtitle?: string;
  propertyType?: string;
  location?: string;
  priceLine?: string;
  coverImage?: string | null;
  overviewBody?: string;
  highlights?: string[];
  settingBody?: string;
  lifestyleBody?: string;
  amenities?: string[];
  apartmentFeatures?: string[];
  connectivityIntro?: string;
  connectivityPlaces?: ConnectivityPlace[];
  mapImage?: string | null;
  floorPlans?: { label: string; image: string | null }[];
  gallery?: GalleryCategory[];
  reraId?: string;
  ctaImage?: string | null;
};

export async function getStaticPaths() {
  try {
    const reader = createReader(process.cwd(), keystaticConfig);
    const entries = await reader.collections.projects.all();
    return entries.map(({ slug, entry }) => ({
      params: { slug },
      props: { project: entry as unknown as Project },
    }));
  } catch (error) {
    return [];
  }
}

const { project } = Astro.props as { project: Project };

const paragraphs = (text?: string) =>
  (text || "")
    .split(/\n+/)
    .map((p) => p.trim())
    .filter(Boolean);

const highlights = project.highlights ?? [];
const amenities = project.amenities ?? [];
const apartmentFeatures = project.apartmentFeatures ?? [];
const connectivityPlaces = project.connectivityPlaces ?? [];
const floorPlans = (project.floorPlans ?? []).filter((plan) => plan.image);
const gallery = (project.gallery ?? [])
  .map((category) => ({
    ...category,
    images: (category.images ?? []).filter(
      (image): image is string => Boolean(image),
    ),
  }))
  .filter((category) => category.images.length > 0);

const icons: Record<ConnectivityPlace["icon"], string> = {
  airport: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  train: '<rect x="4" y="3" width="16" height="14" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h.01"/><path d="M16 15h.01"/>',
  beach: '<path d="M12 13v8"/><path d="M12 3a9 9 0 0 0-9 9"/><path d="M12 3a9 9 0 0 1 9 9"/><path d="M12 3v10"/><path d="M5.5 5.5 12 12"/><path d="m18.5 5.5-6.5 6.5"/><path d="M2 21c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"/>',
  shopping: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  city: '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>',
};
---

<Layout
  title={`${project.title} – Hindustan Developers`}
  description={project.subtitle || `${project.title} by Hindustan Developers, Goa.`}
>
  <Navbar variant="light" />

  <main class="bg-[var(--color-cream)] text-[#10183B] overflow-x-clip">
    <!-- HERO -->
    <section class="bg-white">
      <div
        data-reveal-group
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pt-[140px] lg:pt-[180px] pb-[48px] lg:pb-[72px] text-center"
      >
        {
          project.location && (
            <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              {project.location}
            </span>
          )
        }
        <h1
          data-reveal-title
          class="mt-[24px] lg:mt-[32px] font-heading font-bold text-[38px] leading-[44px] md:text-[56px] md:leading-[62px] lg:text-[72px] lg:leading-[78px] tracking-[-0.02em]"
        >
          {project.title}
        </h1>
        {
          project.subtitle && (
            <p data-reveal-text class="mt-[16px] lg:mt-[20px] mx-auto max-w-[760px] text-[14px] lg:text-[16px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
              {project.subtitle}
            </p>
          )
        }
        {
          project.priceLine && (
            <p data-reveal-text class="mt-[14px] lg:mt-[16px] text-[14px] lg:text-[15px] font-medium text-[#10183B]/60">
              {project.priceLine}
            </p>
          )
        }
        <div
          data-reveal-btn
          class="mt-[24px] lg:mt-[28px] flex flex-wrap items-center justify-center gap-[20px]"
        >
          <a
            href="/contact"
            class="inline-flex no-underline items-center gap-[12px] h-[52px] pl-[24px] pr-[6px] rounded-full border border-[#10183B]/15 bg-white text-[14px] font-medium text-[#10183B] hover:border-[#10183B]/40 transition-colors"
          >
            Submit an Enquiry
            <span
              class="w-[40px] h-[40px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
          {
            floorPlans.length > 0 && (
              <a
                href="#floor-plans"
                class="text-[14px] font-medium text-[#10183B] underline underline-offset-4 hover:text-[#10183B]/60 transition-colors"
              >
                View floor plans
              </a>
            )
          }
        </div>
        {
          project.coverImage && (
            <div class="mt-[40px] lg:mt-[56px] rounded-[24px] lg:rounded-[32px] overflow-hidden">
              <img
                data-reveal-img
                src={project.coverImage}
                alt={project.title}
                class="w-full aspect-[4/3] md:aspect-[16/8] object-cover"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </section>

    <!-- PROJECT OVERVIEW -->
    <section>
      <div
        data-reveal-group
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px]"
      >
        <span
          data-reveal-text
          class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
        >
          <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]"></span>
          Project Overview
        </span>
        <h2
          data-reveal-title
          class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em]"
        >
          Details That Shape a Better Everyday
        </h2>
        <div data-reveal-text class="mt-[20px] lg:mt-[24px] space-y-[16px] max-w-full">
          {
            paragraphs(project.overviewBody).map((paragraph) => (
              <p class="text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
                {paragraph}
              </p>
            ))
          }
        </div>
        {
          highlights.length > 0 && (
            <div data-reveal-card>
              <h3 class="mt-[36px] lg:mt-[48px] font-heading font-bold text-[24px] lg:text-[28px] tracking-[-0.01em]">
                Project Highlights
              </h3>
              <ul class="mt-[16px] space-y-[10px] list-disc pl-[20px] text-[14px] lg:text-[15px] leading-[24px] text-[#10183B]/80">
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <!-- THE SETTING -->
    {
      project.settingBody && (
        <section>
          <div data-reveal-group class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pb-[56px] lg:pb-[96px]">
            <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              The Setting
            </span>
            <h2 data-reveal-title class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em]">
              Every View Tells a Story
            </h2>
            <p data-reveal-text class="mt-[20px] lg:mt-[24px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
              {project.settingBody}
            </p>
          </div>
        </section>
      )
    }

    <!-- LIFESTYLE SPACES -->
    {
      (project.lifestyleBody || amenities.length > 0 || apartmentFeatures.length > 0) && (
        <section>
          <div data-reveal-group class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pb-[56px] lg:pb-[96px]">
            <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              Lifestyle spaces
            </span>
            <h2 data-reveal-title class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em]">
              More Meaning in the Everyday
            </h2>
            {project.lifestyleBody && (
              <p data-reveal-text class="mt-[20px] lg:mt-[24px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
                {project.lifestyleBody}
              </p>
            )}
            {amenities.length > 0 && (
              <div data-reveal-card>
                <h3 class="mt-[36px] lg:mt-[48px] font-heading font-bold text-[24px] lg:text-[28px] tracking-[-0.01em]">
                  Project amenities
                </h3>
                <ul class="mt-[16px] space-y-[10px] list-disc pl-[20px] text-[14px] lg:text-[15px] leading-[24px] text-[#10183B]/80">
                  {amenities.map((amenity) => (
                    <li>{amenity}</li>
                  ))}
                </ul>
              </div>
            )}
            {apartmentFeatures.length > 0 && (
              <div data-reveal-card>
                <h3 class="mt-[36px] lg:mt-[48px] font-heading font-bold text-[24px] lg:text-[28px] tracking-[-0.01em]">
                  Apartment features
                </h3>
                <ul class="mt-[16px] space-y-[10px] list-disc pl-[20px] text-[14px] lg:text-[15px] leading-[24px] text-[#10183B]/80">
                  {apartmentFeatures.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- CONNECTIVITY -->
    {
      (connectivityPlaces.length > 0 || project.mapImage) && (
        <section>
          <div class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pb-[56px] lg:pb-[96px]">
            <span class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              Connectivity
            </span>
            <div class="mt-[24px] lg:grid lg:grid-cols-2 lg:gap-[64px] lg:items-center">
              <div data-reveal-group>
                <h2 data-reveal-title class="font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em] text-[var(--color-navy)]">
                  Well Connected to Everyday Goa
                </h2>
                {project.connectivityIntro && (
                  <p data-reveal-text class="mt-[16px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/70 max-w-[520px]">
                    {project.connectivityIntro}
                  </p>
                )}
                {connectivityPlaces.length > 0 && (
                  <div class="mt-[28px] grid grid-cols-1 sm:grid-cols-2 gap-x-[32px] gap-y-[24px]" data-reveal-cards>
                    {connectivityPlaces.map((place) => (
                      <div data-reveal-card class="flex items-center gap-[14px]">
                        <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            set:html={icons[place.icon] || icons.city}
                          />
                        </span>
                        <div>
                          <div class="text-[12px] text-[#10183B]/60">{place.name}</div>
                          <div class="font-heading font-bold text-[18px] lg:text-[20px] tracking-[-0.01em]">
                            {place.travelTime}
                          </div>
                          <div class="text-[11px] text-[#10183B]/50">by car</div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              {project.mapImage && (
                <div class="mt-[32px] lg:mt-0 rounded-[24px] overflow-hidden">
                  <img
                    data-reveal-img
                    src={project.mapImage}
                    alt={`Map showing connectivity around ${project.title}`}
                    class="w-full h-auto object-cover"
                    loading="lazy"
                  />
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- FLOOR PLANS -->
    {
      floorPlans.length > 0 && (
        <section id="floor-plans">
          <div data-reveal-group class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px] text-center">
            <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              Floor Plans
            </span>
            <h2 data-reveal-title class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em]">
              Explore the Residences
            </h2>
            <p data-reveal-text class="mt-[16px] mx-auto max-w-[640px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/70">
              View the site plan and apartment layouts to understand how each
              residence has been planned for comfortable, functional living.
            </p>
            <!-- Chips horizontal scroll container -->
            <div data-reveal-btn class="mt-[28px] w-full flex justify-center">
              <div
                id="floor-chips-scroll"
                class:list={[
                  "flex items-center gap-[10px] md:gap-[12px] overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-2 px-3 scroll-smooth mx-auto",
                  floorPlans.length > 5 ? "justify-start" : "justify-center",
                ]}
                style={floorPlans.length > 5 ? "max-width: min(640px, 100%);" : undefined}
              >
                {floorPlans.map((plan, index) => (
                  <button
                    type="button"
                    data-floor-tab={index}
                    class:list={[
                      "h-[44px] px-[22px] md:px-[26px] rounded-full text-[14px] font-medium transition-all whitespace-nowrap shrink-0 cursor-pointer",
                      index === 0
                        ? "bg-white text-[#10183B] shadow-[0_4px_16px_rgba(16,24,59,0.10)]"
                        : "text-[#10183B]/60 hover:text-[#10183B]",
                    ]}
                  >
                    {plan.label}
                  </button>
                ))}
              </div>
            </div>

            <!-- Floor Plan Image with Left and Right Arrows -->
            <div class="relative mt-[28px] max-w-[860px] mx-auto">
              {floorPlans.length > 1 && (
                <button
                  type="button"
                  id="floor-plan-prev"
                  aria-label="Previous floor plan"
                  class="absolute left-[12px] md:left-[20px] top-1/2 -translate-y-1/2 z-20 w-[42px] h-[42px] md:w-[48px] md:h-[48px] rounded-full bg-white/90 hover:bg-white text-[#10183B] shadow-[0_4px_20px_rgba(16,24,59,0.18)] flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer backdrop-blur-md border border-white/60 focus:outline-none focus:ring-2 focus:ring-[#10183B]/20"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
              )}

              {floorPlans.map((plan, index) => (
                <div
                  data-floor-panel={index}
                  class:list={[
                    "rounded-[24px] overflow-hidden shadow-[0_4px_24px_rgba(16,24,59,0.06)] bg-white border border-[#10183B]/5",
                    index === 0 ? "" : "hidden",
                  ]}
                >
                  <img
                    data-reveal-img
                    src={plan.image!}
                    alt={`${project.title} ${plan.label} floor plan`}
                    class="w-full aspect-[4/3] md:aspect-[16/10] object-cover"
                    loading="lazy"
                  />
                </div>
              ))}

              {floorPlans.length > 1 && (
                <button
                  type="button"
                  id="floor-plan-next"
                  aria-label="Next floor plan"
                  class="absolute right-[12px] md:right-[20px] top-1/2 -translate-y-1/2 z-20 w-[42px] h-[42px] md:w-[48px] md:h-[48px] rounded-full bg-white/90 hover:bg-white text-[#10183B] shadow-[0_4px_20px_rgba(16,24,59,0.18)] flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer backdrop-blur-md border border-white/60 focus:outline-none focus:ring-2 focus:ring-[#10183B]/20"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              )}
            </div>
            <p class="mt-[20px] text-[12px] lg:text-[13px] font-medium text-[#10183B]/60">
              Plans are indicative and should be read together with the final
              agreement and approved project documentation.
            </p>
          </div>
        </section>
      )
    }

    <!-- GALLERY -->
    {
      gallery.length > 0 && (
        <section>
          <div class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pb-[56px] lg:pb-[96px] text-center">
            <div data-reveal-group>
              <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
                <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
                Gallery
              </span>
              <h2 data-reveal-title class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[42px] md:leading-[50px] lg:text-[56px] lg:leading-[64px] tracking-[-0.02em]">
                A Glimpse of Life at
                <br class="hidden md:block" />
                {project.title}
              </h2>
            </div>
            <div data-reveal-cards class="mt-[32px] lg:mt-[48px] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px] text-left">
              {gallery.map((category, categoryIndex) => (
                <div
                  data-reveal-card
                  class:list={[
                    "tilt-card relative rounded-[24px] overflow-hidden group",
                    categoryIndex === 0 ? "md:col-span-2 lg:col-span-1" : "",
                  ]}
                  data-gallery-card
                  data-gallery-images={JSON.stringify(category.images)}
                  data-gallery-index="0"
                >
                  <img
                    data-reveal-img
                    src={category.images[0]}
                    alt={`${project.title} – ${category.label}`}
                    class="w-full aspect-[4/3] object-cover"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#10183B]/80 via-[#10183B]/10 to-transparent pointer-events-none" />
                  <div class="absolute left-[20px] bottom-[20px] right-[20px] text-white">
                    <div class="font-heading font-bold text-[22px] lg:text-[24px] tracking-[-0.01em]">
                      {category.label}
                    </div>
                    {category.description && (
                      <p class="mt-[4px] text-[12px] lg:text-[13px] leading-[20px] text-white/80 max-w-[320px]">
                        {category.description}
                      </p>
                    )}
                  </div>
                  {category.images.length > 1 && (
                    <div class="absolute right-[16px] bottom-[16px] flex gap-[8px]">
                      <button
                        type="button"
                        data-gallery-prev
                        aria-label={`Previous ${category.label} image`}
                        class="w-[36px] h-[36px] rounded-full bg-white/20 backdrop-blur text-white flex items-center justify-center hover:bg-white/40 transition-colors"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                      </button>
                      <button
                        type="button"
                        data-gallery-next
                        aria-label={`Next ${category.label} image`}
                        class="w-[36px] h-[36px] rounded-full bg-white/20 backdrop-blur text-white flex items-center justify-center hover:bg-white/40 transition-colors"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                      </button>
                    </div>
                  )}
                </div>
              ))}
            </div>
            <p class="mt-[20px] text-right text-[11px] lg:text-[12px] text-[#10183B]/50">
              Artist's impressions are for representational purposes only.
            </p>
          </div>
        </section>
      )
    }

    <!-- CTA BANNER -->
    <section class="relative overflow-hidden">
      {
        project.ctaImage && (
          <img
            src={project.ctaImage}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        )
      }
      <div class="absolute inset-0 bg-[#10183B]/55"></div>
      <div
        data-reveal-group
        class="relative w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[72px] lg:py-[140px]"
      >
        <h2
          data-reveal-title
          class="font-heading font-bold text-white text-[32px] leading-[40px] md:text-[44px] md:leading-[54px] lg:text-[64px] lg:leading-[72px] tracking-[-0.02em]"
        >
          Interested in {project.title}?
        </h2>
        <p
          data-reveal-text
          class="mt-[16px] max-w-[480px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-white/80"
        >
          Share your details and our sales team will contact you with
          availability, floor plans and the latest project information.
        </p>
        <a
          data-reveal-btn
          href="/contact"
          class="mt-[28px] inline-flex no-underline items-center gap-[12px] h-[52px] pl-[24px] pr-[6px] rounded-full bg-white text-[14px] font-medium text-[#10183B] hover:bg-[var(--color-cream)] transition-colors"
        >
          Submit an Enquiry
          <span
            class="w-[40px] h-[40px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const tabs = Array.from(document.querySelectorAll("[data-floor-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-floor-panel]"));
    const prevBtn = document.getElementById("floor-plan-prev");
    const nextBtn = document.getElementById("floor-plan-next");
    const chipsScroll = document.getElementById("floor-chips-scroll");

    const activeClasses = ["bg-white", "text-[#10183B]", "shadow-[0_4px_16px_rgba(16,24,59,0.10)]"];
    const inactiveClasses = ["text-[#10183B]/60"];

    let currentFloorIndex = 0;
    const totalPlans = tabs.length;

    const setActivePlan = (index) => {
      if (totalPlans === 0) return;
      currentFloorIndex = (index + totalPlans) % totalPlans;

      tabs.forEach((t, i) => {
        const isActive = i === currentFloorIndex;
        t.classList.remove(...activeClasses, ...inactiveClasses, "hover:text-[#10183B]");
        t.classList.add(...(isActive ? activeClasses : [...inactiveClasses, "hover:text-[#10183B]"]));
      });

      panels.forEach((panel, i) => {
        panel.classList.toggle("hidden", i !== currentFloorIndex);
      });

      // Keep active tab smoothly scrolled into container view
      const activeTab = tabs[currentFloorIndex];
      if (chipsScroll && activeTab) {
        const containerRect = chipsScroll.getBoundingClientRect();
        const tabRect = activeTab.getBoundingClientRect();
        if (tabRect.left < containerRect.left) {
          chipsScroll.scrollBy({
            left: tabRect.left - containerRect.left - 16,
            behavior: "smooth",
          });
        } else if (tabRect.right > containerRect.right) {
          chipsScroll.scrollBy({
            left: tabRect.right - containerRect.right + 16,
            behavior: "smooth",
          });
        }
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => setActivePlan(index));
    });

    prevBtn?.addEventListener("click", () => {
      setActivePlan(currentFloorIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      setActivePlan(currentFloorIndex + 1);
    });

    // Constrain container to exactly fit max 5 chips when more than 5 exist
    if (chipsScroll && totalPlans > 5) {
      const updateChipsMaxWidth = () => {
        const firstFive = tabs.slice(0, 5);
        let contentWidth = 0;
        firstFive.forEach((tab) => {
          contentWidth += tab.offsetWidth;
        });
        const computedStyle = window.getComputedStyle(chipsScroll);
        const gap = parseFloat(computedStyle.gap) || 12;
        const paddingLeft = parseFloat(computedStyle.paddingLeft) || 0;
        const paddingRight = parseFloat(computedStyle.paddingRight) || 0;
        const targetMaxWidth = contentWidth + 4 * gap + paddingLeft + paddingRight + 2;
        chipsScroll.style.maxWidth = `min(${targetMaxWidth}px, 100%)`;
      };

      updateChipsMaxWidth();
      window.addEventListener("resize", updateChipsMaxWidth);
      if ("fonts" in document) {
        document.fonts.ready.then(updateChipsMaxWidth);
      }
    }

    // Keyboard navigation when floor-plans section has focus
    document.getElementById("floor-plans")?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        setActivePlan(currentFloorIndex - 1);
      } else if (e.key === "ArrowRight") {
        setActivePlan(currentFloorIndex + 1);
      }
    });

    document.querySelectorAll("[data-gallery-card]").forEach((card) => {
      const images = JSON.parse(card.getAttribute("data-gallery-images") || "[]");
      if (images.length < 2) return;
      const img = card.querySelector("img");
      let index = 0;
      const show = (next) => {
        index = (next + images.length) % images.length;
        img.src = images[index];
      };
      card.querySelector("[data-gallery-prev]")?.addEventListener("click", () => show(index - 1));
      card.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(index + 1));
    });
  </script>
  <TiltCards />
</Layout>
