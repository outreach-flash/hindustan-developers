          <!-- Close Button -->
          <button
            type="button"
            id="floor-lightbox-close"
            aria-label="Close full view"
            class="absolute top-[16px] right-[16px] md:top-[24px] md:right-[28px] z-50 w-[44px] h-[44px] rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center backdrop-blur-md transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer border border-white/20"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>

          <!-- Prev Arrow in Lightbox -->
          {floorPlans.length > 1 && (
            <button
              type="button"
              id="floor-lightbox-prev"
              aria-label="Previous image"
              class="absolute left-[12px] md:left-[24px] top-1/2 -translate-y-1/2 z-50 w-[46px] h-[46px] md:w-[52px] md:h-[52px] rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center backdrop-blur-md transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer border border-white/20 shadow-lg"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
          )}

          <!-- Image & Caption Container -->
          <div class="relative max-w-[94vw] max-h-[88vh] flex flex-col items-center justify-center" id="floor-lightbox-content">
            <img
              id="floor-lightbox-img"
              src=""
              alt=""
              class="max-w-full max-h-[78vh] md:max-h-[82vh] object-contain rounded-[16px] shadow-[0_20px_60px_rgba(0,0,0,0.6)]"
            />
            <div class="mt-[16px] flex items-center gap-[12px] px-[20px] py-[8px] rounded-full bg-white/15 backdrop-blur-md text-white text-[14px] font-medium border border-white/20 shadow-lg">
              <span id="floor-lightbox-title" class="font-semibold tracking-wide"></span>
              <span class="w-[4px] h-[4px] rounded-full bg-white/50"></span>
              <span id="floor-lightbox-counter" class="text-white/70 text-[12px]"></span>
            </div>
          </div>

          <!-- Next Arrow in Lightbox -->
          {floorPlans.length > 1 && (
            <button
              type="button"
              id="floor-lightbox-next"
              aria-label="Next image"
              class="absolute right-[12px] md:right-[24px] top-1/2 -translate-y-1/2 z-50 w-[46px] h-[46px] md:w-[52px] md:h-[52px] rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center backdrop-blur-md transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer border border-white/20 shadow-lg"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          )}
        </div>
      )
    }

    <!-- Gallery Lightbox Modal -->
    {
      gallery.length > 0 && (
        <div
          id="gallery-lightbox"
          class="fixed inset-0 z-[200] hidden flex items-center justify-center bg-[#10183B]/92 backdrop-blur-md p-4 md:p-8 select-none"
          role="dialog"
          aria-modal="true"
          aria-label="Gallery image preview"
        >
          <!-- Close Button -->
          <button
            type="button"
            id="gallery-lightbox-close"
            aria-label="Close full view"
            class="absolute top-[16px] right-[16px] md:top-[24px] md:right-[28px] z-50 w-[44px] h-[44px] rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center backdrop-blur-md transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer border border-white/20"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>

          <!-- Prev Arrow -->
          <button
            type="button"
            id="gallery-lightbox-prev"
            aria-label="Previous gallery image"
            class="absolute left-[12px] md:left-[24px] top-1/2 -translate-y-1/2 z-50 w-[46px] h-[46px] md:w-[52px] md:h-[52px] rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center backdrop-blur-md transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer border border-white/20 shadow-lg"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          <!-- Image & Caption Container -->
          <div class="relative max-w-[94vw] max-h-[88vh] flex flex-col items-center justify-center" id="gallery-lightbox-content">
            <img
              id="gallery-lightbox-img"
              src=""
              alt=""
              class="max-w-full max-h-[72vh] md:max-h-[78vh] object-contain rounded-[16px] shadow-[0_20px_60px_rgba(0,0,0,0.6)]"
            />
            <div class="mt-[16px] flex flex-col items-center text-center max-w-2xl px-4 pointer-events-auto">
              <div class="inline-flex items-center gap-[12px] px-[20px] py-[8px] rounded-full bg-white/15 backdrop-blur-md text-white text-[14px] font-medium border border-white/20 shadow-lg">
                <span id="gallery-lightbox-title" class="font-semibold tracking-wide"></span>
                <span class="w-[4px] h-[4px] rounded-full bg-white/50"></span>
                <span id="gallery-lightbox-counter" class="text-white/70 text-[12px]"></span>
              </div>
              <p id="gallery-lightbox-desc" class="mt-[8px] text-[12px] md:text-[13px] text-white/85 leading-relaxed font-light drop-shadow"></p>
            </div>
          </div>

          <!-- Next Arrow -->
          <button
            type="button"
            id="gallery-lightbox-next"
            aria-label="Next gallery image"
            class="absolute right-[12px] md:right-[24px] top-1/2 -translate-y-1/2 z-50 w-[46px] h-[46px] md:w-[52px] md:h-[52px] rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center backdrop-blur-md transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer border border-white/20 shadow-lg"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      )
    }
  </div>

  <Footer />

  <script>
    const tabs = Array.from(document.querySelectorAll("[data-floor-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-floor-panel]"));
    const prevBtn = document.getElementById("floor-plan-prev");
    const nextBtn = document.getElementById("floor-plan-next");
    const chipsScroll = document.getElementById("floor-chips-scroll");

    const activeClasses = ["bg-white", "text-[#10183B]", "shadow-[0_4px_16px_rgba(16,24,59,0.10)]"];
    const inactiveClasses = ["text-[#10183B]/60"];

    let currentFloorIndex = 0;
    const totalPlans = tabs.length;

    const setActivePlan = (index: number) => {
      if (totalPlans === 0) return;
      currentFloorIndex = (index + totalPlans) % totalPlans;

      tabs.forEach((t, i) => {
        const isActive = i === currentFloorIndex;
        t.classList.remove(...activeClasses, ...inactiveClasses, "hover:text-[#10183B]");
        t.classList.add(...(isActive ? activeClasses : [...inactiveClasses, "hover:text-[#10183B]"]));
      });

      panels.forEach((panel, i) => {
        panel.classList.toggle("hidden", i !== currentFloorIndex);
      });

      // Keep active tab smoothly scrolled into container view
      const activeTab = tabs[currentFloorIndex];
      if (chipsScroll && activeTab) {
        const containerRect = chipsScroll.getBoundingClientRect();
        const tabRect = activeTab.getBoundingClientRect();
        if (tabRect.left < containerRect.left) {
          chipsScroll.scrollBy({
            left: tabRect.left - containerRect.left - 16,
            behavior: "smooth",
          });
        } else if (tabRect.right > containerRect.right) {
          chipsScroll.scrollBy({
            left: tabRect.right - containerRect.right + 16,
            behavior: "smooth",
          });
        }
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => setActivePlan(index));
    });

    prevBtn?.addEventListener("click", () => {
      setActivePlan(currentFloorIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      setActivePlan(currentFloorIndex + 1);
    });

    // Constrain container to exactly fit max 5 chips when more than 5 exist
    if (chipsScroll && totalPlans > 5) {
      const updateChipsMaxWidth = () => {
        const firstFive = tabs.slice(0, 5);
        let contentWidth = 0;
        firstFive.forEach((tab) => {
          contentWidth += tab.offsetWidth;
        });
        const computedStyle = window.getComputedStyle(chipsScroll);
        const gap = parseFloat(computedStyle.gap) || 12;
        const paddingLeft = parseFloat(computedStyle.paddingLeft) || 0;
        const paddingRight = parseFloat(computedStyle.paddingRight) || 0;
        const targetMaxWidth = contentWidth + 4 * gap + paddingLeft + paddingRight + 2;
        chipsScroll.style.maxWidth = `min(${targetMaxWidth}px, 100%)`;
      };

      updateChipsMaxWidth();
      window.addEventListener("resize", updateChipsMaxWidth);
      if ("fonts" in document) {
        document.fonts.ready.then(updateChipsMaxWidth);
      }
    }

    // --- Floor Plan Lightbox ---
    const lightbox = document.getElementById("floor-lightbox");
    const lightboxImg = document.getElementById("floor-lightbox-img") as HTMLImageElement | null;
    const lightboxTitle = document.getElementById("floor-lightbox-title");
    const lightboxCounter = document.getElementById("floor-lightbox-counter");
    const lightboxClose = document.getElementById("floor-lightbox-close");
    const lightboxPrev = document.getElementById("floor-lightbox-prev");
    const lightboxNext = document.getElementById("floor-lightbox-next");
    const zoomBtn = document.getElementById("floor-plan-zoom");

    function isLightboxOpen() {
      return !!lightbox && !lightbox.classList.contains("hidden");
    }

    function updateLightbox() {
      if (!lightboxImg || totalPlans === 0) return;
      const currentPanel = panels[currentFloorIndex];
      const img = currentPanel?.querySelector("img");
      const currentTab = tabs[currentFloorIndex];
      if (img) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
      }
      if (lightboxTitle && currentTab) {
        lightboxTitle.textContent = currentTab.textContent?.trim() || "";
      }
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentFloorIndex + 1} of ${totalPlans}`;
      }
    }

    function openLightbox() {
      if (!lightbox) return;
      if (lightbox.parentElement !== document.body) {
        document.body.appendChild(lightbox);
      }
      updateLightbox();
      lightbox.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      (window as any).__smoother?.paused(true);
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add("hidden");
      document.body.style.overflow = "";
      (window as any).__smoother?.paused(false);
    }

    zoomBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openLightbox();
    });

    panels.forEach((panel) => {
      panel.addEventListener("click", () => {
        openLightbox();
      });
    });

    lightboxClose?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeLightbox();
    });

    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    lightboxPrev?.addEventListener("click", (e) => {
      e.stopPropagation();
      setActivePlan(currentFloorIndex - 1);
      updateLightbox();
    });

    lightboxNext?.addEventListener("click", (e) => {
      e.stopPropagation();
      setActivePlan(currentFloorIndex + 1);
      updateLightbox();
    });

    // --- Gallery Lightbox ---
    const galleryLightbox = document.getElementById("gallery-lightbox");
    const galleryLightboxImg = document.getElementById("gallery-lightbox-img") as HTMLImageElement | null;
    const galleryLightboxTitle = document.getElementById("gallery-lightbox-title");
    const galleryLightboxDesc = document.getElementById("gallery-lightbox-desc");
    const galleryLightboxCounter = document.getElementById("gallery-lightbox-counter");
    const galleryLightboxClose = document.getElementById("gallery-lightbox-close");
    const galleryLightboxPrev = document.getElementById("gallery-lightbox-prev");
    const galleryLightboxNext = document.getElementById("gallery-lightbox-next");

    const galleryCards = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-card]"));
    let currentGalleryIndex = 0;

    function isGalleryLightboxOpen() {
      return !!galleryLightbox && !galleryLightbox.classList.contains("hidden");
    }

    function updateGalleryLightbox() {
      if (!galleryLightboxImg || galleryCards.length === 0) return;
      const card = galleryCards[currentGalleryIndex];
      if (!card) return;
      const cardImg = card.querySelector("img");
      const title = card.getAttribute("data-gallery-label") || "";
      const desc = card.getAttribute("data-gallery-desc") || "";
      const fallbackSrc = card.getAttribute("data-gallery-img") || "";

      galleryLightboxImg.src = cardImg?.src || fallbackSrc;
      galleryLightboxImg.alt = cardImg?.alt || title;

      if (galleryLightboxTitle) {
        galleryLightboxTitle.textContent = title;
      }
      if (galleryLightboxDesc) {
        galleryLightboxDesc.textContent = desc;
        galleryLightboxDesc.style.display = desc ? "block" : "none";
      }
      if (galleryLightboxCounter) {
        galleryLightboxCounter.textContent = `${currentGalleryIndex + 1} of ${galleryCards.length}`;
      }
    }

    function openGalleryLightbox(index: number) {
      if (!galleryLightbox || galleryCards.length === 0) return;
      if (galleryLightbox.parentElement !== document.body) {
        document.body.appendChild(galleryLightbox);
      }
      currentGalleryIndex = (index + galleryCards.length) % galleryCards.length;
      updateGalleryLightbox();
      galleryLightbox.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      (window as any).__smoother?.paused(true);
    }

    function closeGalleryLightbox() {
      if (!galleryLightbox) return;
      galleryLightbox.classList.add("hidden");
      document.body.style.overflow = "";
      (window as any).__smoother?.paused(false);
    }

    // Card click opens gallery lightbox
    galleryCards.forEach((card, idx) => {
      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("[data-gallery-prev], [data-gallery-next]")) {
          return;
        }
        openGalleryLightbox(idx);
      });
    });

    galleryLightboxClose?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeGalleryLightbox();
    });

    galleryLightbox?.addEventListener("click", (e) => {
      if (e.target === galleryLightbox) {
        closeGalleryLightbox();
      }
    });

    galleryLightboxPrev?.addEventListener("click", (e) => {
      e.stopPropagation();
      currentGalleryIndex = (currentGalleryIndex - 1 + galleryCards.length) % galleryCards.length;
      updateGalleryLightbox();
    });

    galleryLightboxNext?.addEventListener("click", (e) => {
      e.stopPropagation();
      currentGalleryIndex = (currentGalleryIndex + 1) % galleryCards.length;
      updateGalleryLightbox();
    });

    // Prevent wheel/touch from scrolling the page behind while modal is open
    [lightbox, galleryLightbox].forEach((el) => {
      if (!el) return;
      el.addEventListener("wheel", (e) => e.preventDefault(), { passive: false });
      el.addEventListener("touchmove", (e) => e.preventDefault(), { passive: false });
    });

    // Global Keyboard navigation
    window.addEventListener("keydown", (e) => {
      if (isLightboxOpen()) {
        if (e.key === "Escape") {
          closeLightbox();
        } else if (e.key === "ArrowLeft") {
          setActivePlan(currentFloorIndex - 1);
          updateLightbox();
        } else if (e.key === "ArrowRight") {
          setActivePlan(currentFloorIndex + 1);
          updateLightbox();
        }
      } else if (isGalleryLightboxOpen()) {
        if (e.key === "Escape") {
          closeGalleryLightbox();
        } else if (e.key === "ArrowLeft") {
          currentGalleryIndex = (currentGalleryIndex - 1 + galleryCards.length) % galleryCards.length;
          updateGalleryLightbox();
        } else if (e.key === "ArrowRight") {
          currentGalleryIndex = (currentGalleryIndex + 1) % galleryCards.length;
          updateGalleryLightbox();
        }
      } else {
        const floorPlansSec = document.getElementById("floor-plans");
        if (
          floorPlansSec &&
          (floorPlansSec.contains(document.activeElement) || floorPlansSec.matches(":hover"))
        ) {
          if (e.key === "ArrowLeft") {
            setActivePlan(currentFloorIndex - 1);
          } else if (e.key === "ArrowRight") {
            setActivePlan(currentFloorIndex + 1);
          }
        }
      }
    });

    // Gallery Card internal carousel controls
    document.querySelectorAll("[data-gallery-card]").forEach((card) => {
      const images: string[] = JSON.parse(
        card.getAttribute("data-gallery-images") || "[]",
      );
      if (images.length < 2) return;
      const img = card.querySelector("img");
      let index = 0;
      const show = (next: number) => {
        index = (next + images.length) % images.length;
        if (img) img.src = images[index];
      };
      card.querySelector("[data-gallery-prev]")?.addEventListener("click", (e) => {
        e.stopPropagation();
        show(index - 1);
      });
      card.querySelector("[data-gallery-next]")?.addEventListener("click", (e) => {
        e.stopPropagation();
        show(index + 1);
      });
    });
  </script>
  <TiltCards />
</Layout>
