---
export const prerender = true;
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import TiltCards from "../../components/TiltCards.astro";

type ConnectivityPlace = {
  name: string;
  travelTime: string;
  icon:
    | "airport"
    | "train"
    | "beach"
    | "shopping"
    | "city"
    | "hospital"
    | "school"
    | "railway";
};

type GalleryCategory = {
  label: string;
  description: string;
  images: (string | null)[];
};

type Project = {
  title: string;
  subtitle?: string;
  propertyType?: string;
  location?: string;
  priceLine?: string;
  coverImage?: string | null;
  overviewBody?: string;
  highlights?: string[];
  settingBody?: string;
  lifestyleBody?: string;
  amenities?: string[];
  apartmentFeatures?: string[];
  connectivityIntro?: string;
  connectivityPlaces?: ConnectivityPlace[];
  mapImage?: string | null;
  floorPlans?: { label: string; image: string | null }[];
  gallery?: GalleryCategory[];
  reraId?: string;
  ctaImage?: string | null;
  details?: { key: string; value: string }[];
};

export async function getStaticPaths() {
  try {
    const reader = createReader(process.cwd(), keystaticConfig);
    const entries = await reader.collections.projects.all();
    return entries.map(({ slug, entry }) => ({
      params: { slug },
      props: { project: entry as unknown as Project },
    }));
  } catch (error) {
    return [];
  }
}

const { project } = Astro.props as { project: Project };

const paragraphs = (text?: string) =>
  (text || "")
    .split(/\n+/)
    .map((p) => p.trim())
    .filter(Boolean);

const highlights = project.highlights ?? [];
const amenities = project.amenities ?? [];
const apartmentFeatures = project.apartmentFeatures ?? [];
const connectivityPlaces = project.connectivityPlaces ?? [];
const floorPlans = (project.floorPlans ?? []).filter((plan) => plan.image);
const gallery = (project.gallery ?? [])
  .map((category) => ({
    ...category,
    images: (category.images ?? []).filter(
      (image): image is string => Boolean(image),
    ),
  }))
  .filter((category) => category.images.length > 0);

export const icons: Record<ConnectivityPlace["icon"], string> = {
  airport:
    '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  train:
    '<rect x="4" y="3" width="16" height="14" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h.01"/><path d="M16 15h.01"/>',
  railway:
    '<rect x="4" y="3" width="16" height="14" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h.01"/><path d="M16 15h.01"/>',
  beach:
    '<path d="M12 13v8"/><path d="M12 3a9 9 0 0 0-9 9"/><path d="M12 3a9 9 0 0 1 9 9"/><path d="M12 3v10"/><path d="M5.5 5.5 12 12"/><path d="m18.5 5.5-6.5 6.5"/><path d="M2 21c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"/>',
  shopping:
    '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  city:
    '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>',
  hospital:
    '<path d="M12 6v4"/><path d="M14 8h-4"/><path d="M18 18h2a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h2"/><path d="M18 22H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2Z"/>',
  school:
    '<path d="m4 6 8-4 8 4"/><path d="m18 10 4 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8l4-2"/><path d="M14 22v-4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v4"/><path d="M18 5v17"/><path d="M6 5v17"/><circle cx="12" cy="9" r="2"/>',
};

const details = project.details ?? [];

// Decorative images from existing project assets (content JSON untouched)
const overviewImage = "/images/projects/serene-meadows/View 02 v02.webp";
const settingImage = "/images/projects/serene-meadows/View 06 v02.webp";
const lifestyleImage = "/images/projects/serene-meadows/View 07 v02.webp";
const specsImage = "/images/projects/serene-meadows/Living Dining.webp";

const fallbackIcon =
  '<circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>';

const amenityIcons: Record<string, string> = {
  "Swimming pool":
    '<path d="M2 17c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"/><path d="M2 21c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"/><path d="M9 4.5A2.5 2.5 0 1 1 11.5 7c-.5 2.5-2 4-4.5 5"/>',
  "Well-equipped gymnasium":
    '<path d="M4 9v6"/><path d="M7 7v10"/><path d="M17 7v10"/><path d="M20 9v6"/><path d="M7 12h10"/>',
  "Landscaped garden and green areas":
    '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  "Double-height atrium":
    '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>',
  "Community hall with pantry and common washroom":
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  "Car parking":
    '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  "Large terrace spaces":
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  "Power backup for lifts and common areas":
    '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  "CCTV surveillance":
    '<path d="m16 10 6-3v10l-6-3"/><rect x="2" y="6" width="14" height="12" rx="2"/>',
  "Provision for solar water heaters":
    '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  "Provision for EV charging":
    '<path d="M9 2v6"/><path d="M15 2v6"/><path d="M12 17v5"/><path d="M5 8h14v3a7 7 0 0 1-14 0V8z"/>',
  "24/7 manned gate":
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};

const featureIcons: Record<string, string> = {
  "Jaquar make stainless-steel fittings":
    '<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M2 14h4"/><path d="M10 8h4"/><path d="M18 16h4"/>',
  "Anchor/Finolex fire-resistant wiring":
    '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
  "Concrete-reinforced sloping roof with tiles":
    '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  "Teakwood main door":
    '<rect x="5" y="2" width="14" height="20" rx="1"/><circle cx="15.5" cy="12" r="1"/>',
  "Solid wood bedroom doors":
    '<path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/>',
  "UPVC windows":
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/><path d="M3 12h18"/>',
};
---

<Layout
  title={`${project.title} – Hindustan Developers`}
  description={project.subtitle || `${project.title} by Hindustan Developers, Goa.`}
>
  <Navbar slot="navbar" variant="light" />

  <main class="bg-[var(--color-cream)] text-[#10183B] overflow-x-clip">
    <!-- HERO -->
    <section class="bg-white relative flex flex-col justify-between h-screen min-h-[640px] overflow-hidden">
      <div
        data-reveal-group
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pt-[95px] lg:pt-[110px] pb-[16px] lg:pb-[24px] text-center flex-shrink-0"
      >
        {
          project.location && (
            <span data-reveal-text class="inline-flex items-center gap-[10px] h-[40px] lg:h-[44px] px-[18px] lg:px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              {project.location}
            </span>
          )
        }
        <h1
          data-reveal-title
          class="mt-[14px] lg:mt-[20px] font-heading font-bold text-[34px] leading-[40px] md:text-[46px] md:leading-[52px] lg:text-[60px] lg:leading-[66px] tracking-[-0.02em]"
        >
          {project.title}
        </h1>
        {
          project.subtitle && (
            <p data-reveal-text class="mt-[10px] lg:mt-[14px] mx-auto max-w-[760px] text-[13px] lg:text-[15px] leading-[22px] lg:leading-[26px] text-[#10183B]/80">
              {project.subtitle}
            </p>
          )
        }
        {
          project.priceLine && (
            <p data-reveal-text class="mt-[8px] lg:mt-[10px] text-[13px] lg:text-[14px] font-medium text-[#10183B]/60">
              {project.priceLine}
            </p>
          )
        }
        <div
          data-reveal-btn
          class="mt-[16px] lg:mt-[20px] flex flex-wrap items-center justify-center gap-[16px] lg:gap-[20px]"
        >
          <a
            href={`/contact?interest=${encodeURIComponent(project.title)}`}
            class="inline-flex no-underline items-center gap-[12px] h-[46px] lg:h-[50px] pl-[22px] lg:pl-[24px] pr-[6px] rounded-full border border-[#10183B]/15 bg-white text-[14px] font-medium text-[#10183B] hover:border-[#10183B]/40 transition-colors"
          >
            Submit an Enquiry
            <span
              class="w-[36px] h-[36px] lg:w-[38px] lg:h-[38px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
          {
            floorPlans.length > 0 && (
              <a
                href="#floor-plans"
                class="text-[14px] font-medium text-[#10183B] underline underline-offset-4 hover:text-[#10183B]/60 transition-colors"
              >
                View floor plans
              </a>
            )
          }
        </div>
      </div>
      {
        project.coverImage && (
          <div class="w-full flex-1 min-h-0 overflow-hidden">
            <img
              data-reveal-img
              src={project.coverImage}
              alt={project.title}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        )
      }
    </section>

    <!-- PROJECT OVERVIEW -->
    <section>
      <div
        data-reveal-group
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px]"
      >
        <div class="lg:grid lg:grid-cols-2 lg:gap-[64px] lg:items-center">
          <div class="rounded-[24px] overflow-hidden">
            <img
              data-reveal-img
              src={overviewImage}
              alt={project.title}
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
            />
          </div>
          <div class="mt-[36px] lg:mt-0">
            <span
              data-reveal-text
              class="text-[12px] font-medium tracking-[0.22em] uppercase text-[var(--color-gold)]"
            >
              Project Overview
            </span>
            <h2
              data-reveal-title
              class="mt-[16px] font-serif text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[44px] lg:leading-[52px] tracking-[-0.01em] text-[var(--color-navy)]"
            >
              Details That Shape a Better Everyday
            </h2>
            <div data-reveal-text class="mt-[20px] lg:mt-[24px] space-y-[16px] max-w-full">
              {
                paragraphs(project.overviewBody).map((paragraph) => (
                  <p class="text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
                    {paragraph}
                  </p>
                ))
              }
            </div>
            {
              details.length > 0 && (
                <div
                  data-reveal-cards
                  class="mt-[32px] lg:mt-[40px] grid grid-cols-2 sm:grid-cols-1 gap-x-[20px] gap-y-[24px]"
                >
                  {details.slice(3).map((detail) => (
                    <div
                      data-reveal-card
                      class="border-t-2 border-[var(--color-gold)]/50 pt-[14px]"
                    >
                      <div class="font-serif text-[24px] lg:text-[28px] leading-[30px] text-[var(--color-navy)]">
                        {detail.key + " " + detail.value}
                      </div>
                      {/* <div class="mt-[4px] text-[12px] leading-[18px] text-[#10183B]/60">
                        {detail.key}
                      </div> */}
                    </div>
                  ))}
                </div>
              )
            }
          </div>
        </div>
        {
          highlights.length > 0 && (
            <div data-reveal-card class="mt-[40px] lg:mt-[56px]">
              <h3 class="font-heading font-bold text-[24px] lg:text-[28px] tracking-[-0.01em]">
                Project Highlights
              </h3>
              <ul class="mt-[16px] grid sm:grid-cols-2 gap-x-[32px] gap-y-[12px] text-[14px] lg:text-[15px] leading-[24px] text-[#10183B]/80">
                {highlights.map((highlight) => (
                  <li class="flex items-start gap-[10px]">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="var(--color-gold)"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-[3px] shrink-0"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <!-- SETTING & LIFESTYLE -->
    {
      (project.settingBody || project.lifestyleBody) && (
        <section>
          <div class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pb-[56px] lg:pb-[96px]">
            <div class="grid gap-[48px] lg:grid-cols-2 lg:gap-[64px]">
              {project.settingBody && (
                <div data-reveal-group>
                  <span data-reveal-text class="text-[12px] font-medium tracking-[0.22em] uppercase text-[var(--color-gold)]">
                    The Setting
                  </span>
                  <h2 data-reveal-title class="mt-[16px] font-serif text-[30px] leading-[38px] md:text-[36px] md:leading-[44px] lg:text-[40px] lg:leading-[48px] tracking-[-0.01em] text-[var(--color-navy)]">
                    Every View Tells a Story
                  </h2>
                  <p data-reveal-text class="mt-[20px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
                    {project.settingBody}
                  </p>
                  <a
                    data-reveal-btn
                    href="#connectivity"
                    class="mt-[20px] inline-flex w-fit no-underline items-center gap-[8px] text-[13px] font-medium tracking-[0.12em] uppercase text-[var(--color-gold)] hover:text-[var(--color-navy)] transition-colors"
                  >
                    Discover the Location
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                  <div class="mt-[28px] rounded-[24px] overflow-hidden">
                    <img
                      data-reveal-img
                      src={settingImage}
                      alt={`${project.title} setting`}
                      class="w-full aspect-[4/3] object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}
              {project.lifestyleBody && (
                <div data-reveal-group>
                  <span data-reveal-text class="text-[12px] font-medium tracking-[0.22em] uppercase text-[var(--color-gold)]">
                    Lifestyle spaces
                  </span>
                  <h2 data-reveal-title class="mt-[16px] font-serif text-[30px] leading-[38px] md:text-[36px] md:leading-[44px] lg:text-[40px] lg:leading-[48px] tracking-[-0.01em] text-[var(--color-navy)]">
                    More Meaning in the Everyday
                  </h2>
                  <p data-reveal-text class="mt-[20px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/80">
                    {project.lifestyleBody}
                  </p>
                  <a
                    data-reveal-btn
                    href="#amenities"
                    class="mt-[20px] inline-flex w-fit no-underline items-center gap-[8px] text-[13px] font-medium tracking-[0.12em] uppercase text-[var(--color-gold)] hover:text-[var(--color-navy)] transition-colors"
                  >
                    Explore Amenities
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                  <div class="mt-[28px] rounded-[24px] overflow-hidden">
                    <img
                      data-reveal-img
                      src={lifestyleImage}
                      alt={`${project.title} lifestyle spaces`}
                      class="w-full aspect-[4/3] object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- AMENITIES -->
    {
      amenities.length > 0 && (
        <section
          id="amenities"
          class="bg-[var(--color-dark-section)] min-h-screen min-h-[100dvh] flex items-center justify-center"
        >
          <div
            data-reveal-group
            class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px] text-center"
          >
            
            <h2 data-reveal-title class="mt-[16px] font-serif text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[44px] lg:leading-[52px] tracking-[-0.01em] text-white">
              Project amenities
            </h2>
            <div
              data-reveal-cards
              class="mt-[36px] lg:mt-[48px] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-[16px] gap-y-[32px]"
            >
              {amenities.map((amenity) => (
                <div data-reveal-card class="flex flex-col items-center gap-[12px]">
                  <span class="w-[52px] h-[52px] rounded-full border border-[var(--color-gold)]/40 text-[var(--color-gold)] flex items-center justify-center">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={amenityIcons[amenity] || fallbackIcon}
                    />
                  </span>
                  <span class="text-[12px] lg:text-[13px] leading-[18px] text-white/80 max-w-[160px]">
                    {amenity}
                  </span>
                </div> 
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- APARTMENT FEATURES -->
    {
      apartmentFeatures.length > 0 && (
        <section>
          <div
            data-reveal-group
            class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px]"
          >
            <div class="lg:grid lg:grid-cols-2 lg:gap-[64px] lg:items-center">
              <div class="rounded-[24px] overflow-hidden">
                <img
                  data-reveal-img
                  src={specsImage}
                  alt={`${project.title} apartment interior`}
                  class="w-full aspect-[4/3] object-cover"
                  loading="lazy"
                />
              </div>
              <div class="mt-[36px] lg:mt-0">
                <span data-reveal-text class="text-[12px] font-medium tracking-[0.22em] uppercase text-[var(--color-gold)]">
                  Apartment features
                </span>
                <h2 data-reveal-title class="mt-[16px] font-serif text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[44px] lg:leading-[52px] tracking-[-0.01em] text-[var(--color-navy)]">
                  Apartment features
                </h2>
                <div data-reveal-cards class="mt-[28px] grid grid-cols-1 sm:grid-cols-2 gap-x-[24px] gap-y-[20px]">
                  {apartmentFeatures.map((feature) => (
                    <div data-reveal-card class="flex items-center gap-[14px]">
                      <span class="shrink-0 w-[44px] h-[44px] rounded-full border border-[var(--color-gold)]/40 text-[var(--color-gold)] flex items-center justify-center">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          set:html={featureIcons[feature] || fallbackIcon}
                        />
                      </span>
                      <span class="text-[13px] lg:text-[14px] leading-[20px] text-[#10183B]/80">
                        {feature}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- CONNECTIVITY -->
    {
      (connectivityPlaces.length > 0 || project.mapImage) && (
        <section id="connectivity" class="bg-[var(--color-dark-section)]">
          <div class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px]">
            <div class="lg:grid lg:grid-cols-2 lg:gap-[64px] lg:items-center">
              <div data-reveal-group>
                <span data-reveal-text class="text-[12px] font-medium tracking-[0.22em] uppercase text-[var(--color-gold)]">
                  Connectivity
                </span>
                <h2 data-reveal-title class="mt-[16px] font-serif text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[44px] lg:leading-[52px] tracking-[-0.01em] text-white">
                  Well Connected to Everyday Goa
                </h2>
                {project.connectivityIntro && (
                  <p data-reveal-text class="mt-[16px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-white/70 max-w-[520px]">
                    {project.connectivityIntro}
                  </p>
                )}
                {connectivityPlaces.length > 0 && (
                  <div class="mt-[28px] grid grid-cols-1 sm:grid-cols-2 gap-x-[16px] gap-y-[16px]" data-reveal-cards>
                    {connectivityPlaces.map((place) => (
                      <div
                        data-reveal-card
                        class="flex items-center gap-[14px] rounded-[16px] border border-white/10 bg-white/5 p-[16px]"
                      >
                        <span class="shrink-0 w-[44px] h-[44px] rounded-full border border-[var(--color-gold)]/40 text-[var(--color-gold)] flex items-center justify-center">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            set:html={icons[place.icon] || icons.city}
                          />
                        </span>
                        <div>
                          <div class="text-[12px] text-white/60">{place.name}</div>
                          <div class="font-serif text-[18px] lg:text-[20px] tracking-[-0.01em] text-white">
                            {place.travelTime}
                          </div>
                          <div class="text-[11px] text-white/40">by car</div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              {project.mapImage && (
                <div class="mt-[32px] lg:mt-0 rounded-[24px] overflow-hidden">
                  <img
                    data-reveal-img
                    src={project.mapImage}
                    alt={`Map showing connectivity around ${project.title}`}
                    class="w-full h-auto object-cover"
                    loading="lazy"
                  />
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- FLOOR PLANS -->
    {
      floorPlans.length > 0 && (
        <section id="floor-plans">
          <div data-reveal-group class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[56px] lg:py-[96px] text-center">
            <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
              Floor Plans
            </span>
            <h2 data-reveal-title class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em]">
              Explore the Residences
            </h2>
            <p data-reveal-text class="mt-[16px] mx-auto max-w-[640px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/70">
              View the site plan and apartment layouts to understand how each
              residence has been planned for comfortable, functional living.
            </p>
            <!-- Chips horizontal scroll container -->
            <div data-reveal-btn class="mt-[28px] w-full flex justify-center">
              <div
                id="floor-chips-scroll"
                class:list={[
                  "flex items-center gap-[10px] md:gap-[12px] overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-2 px-3 scroll-smooth mx-auto",
                  floorPlans.length > 5 ? "justify-start" : "justify-center",
                ]}
                style={floorPlans.length > 5 ? "max-width: min(640px, 100%);" : undefined}
              >
                {floorPlans.map((plan, index) => (
                  <button
                    type="button"
                    data-floor-tab={index}
                    class:list={[
                      "h-[44px] px-[22px] md:px-[26px] rounded-full text-[14px] font-medium transition-all whitespace-nowrap shrink-0 cursor-pointer",
                      index === 0
                        ? "bg-white text-[#10183B] shadow-[0_4px_16px_rgba(16,24,59,0.10)]"
                        : "text-[#10183B]/60 hover:text-[#10183B]",
                    ]}
                  >
                    {plan.label}
                  </button>
                ))}
              </div>
            </div>

            <!-- Floor Plan Image with Left and Right Arrows + Magnify Button -->
            <div class="relative mt-[28px] max-w-[860px] mx-auto">
              <!-- Magnify / Expand Button -->
              <button
                type="button"
                id="floor-plan-zoom"
                aria-label="Expand and see full image"
                class="absolute right-[14px] top-[14px] md:right-[20px] md:top-[20px] z-20 w-[42px] h-[42px] md:w-[46px] md:h-[46px] rounded-full bg-white/90 hover:bg-white text-[#10183B] shadow-[0_4px_20px_rgba(16,24,59,0.18)] flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer backdrop-blur-md border border-white/60 focus:outline-none focus:ring-2 focus:ring-[#10183B]/20 group"
                title="Expand and see full image"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  <line x1="11" y1="8" x2="11" y2="14"/>
                  <line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
              </button>

              {floorPlans.length > 1 && (
                <button
                  type="button"
                  id="floor-plan-prev"
                  aria-label="Previous floor plan"
                  class="absolute left-[12px] md:left-[20px] top-1/2 -translate-y-1/2 z-20 w-[42px] h-[42px] md:w-[48px] md:h-[48px] rounded-full bg-white/90 hover:bg-white text-[#10183B] shadow-[0_4px_20px_rgba(16,24,59,0.18)] flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer backdrop-blur-md border border-white/60 focus:outline-none focus:ring-2 focus:ring-[#10183B]/20"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
              )}

              {floorPlans.map((plan, index) => (
                <div
                  data-floor-panel={index}
                  class:list={[
                    "rounded-[24px] overflow-hidden shadow-[0_4px_24px_rgba(16,24,59,0.06)] bg-white border border-[#10183B]/5 cursor-zoom-in",
                    index === 0 ? "" : "hidden",
                  ]}
                >
                  <img
                    data-reveal-img
                    src={plan.image!}
                    alt={`${project.title} ${plan.label} floor plan`}
                    class="w-full aspect-[4/3] md:aspect-[16/10] object-cover"
                    loading="lazy"
                  />
                </div>
              ))}

              {floorPlans.length > 1 && (
                <button
                  type="button"
                  id="floor-plan-next"
                  aria-label="Next floor plan"
                  class="absolute right-[12px] md:right-[20px] top-1/2 -translate-y-1/2 z-20 w-[42px] h-[42px] md:w-[48px] md:h-[48px] rounded-full bg-white/90 hover:bg-white text-[#10183B] shadow-[0_4px_20px_rgba(16,24,59,0.18)] flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer backdrop-blur-md border border-white/60 focus:outline-none focus:ring-2 focus:ring-[#10183B]/20"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              )}
            </div>
            <p class="mt-[20px] text-[12px] lg:text-[13px] font-medium text-[#10183B]/60">
              Plans are indicative and should be read together with the final
              agreement and approved project documentation.
            </p>
          </div>
        </section>
      )
    }

    <!-- GALLERY -->
    {
      gallery.length > 0 && (
        <section id="gallery">
          <div class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pb-[56px] lg:pb-[96px] text-center">
            <div data-reveal-group>
              <span data-reveal-text class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium">
                <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]" />
                Gallery
              </span>
              <h2 data-reveal-title class="mt-[24px] font-heading font-bold text-[30px] leading-[38px] md:text-[42px] md:leading-[50px] lg:text-[56px] lg:leading-[64px] tracking-[-0.02em]">
                A Glimpse of Life at
                <br class="hidden md:block" />
                {project.title}
              </h2>
            </div>
            <div data-reveal-cards class="mt-[32px] lg:mt-[48px] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px] text-left">
              {gallery.map((category, categoryIndex) => (
                <div
                  data-reveal-card
                  class:list={[
                    "tilt-card relative rounded-[24px] overflow-hidden group cursor-pointer",
                    categoryIndex === 0 ? "md:col-span-2 lg:col-span-1" : "",
                  ]}
                  data-gallery-card
                  data-gallery-index={categoryIndex}
                  data-gallery-label={category.label}
                  data-gallery-desc={category.description || ""}
                  data-gallery-img={category.images[0] || ""}
                  data-gallery-images={JSON.stringify(category.images)}
                >
                  <img
                    data-reveal-img
                    src={category.images[0]}
                    alt={`${project.title} – ${category.label}`}
                    class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#10183B]/80 via-[#10183B]/10 to-transparent pointer-events-none" />
                  
                  <!-- Hover expand hint -->
                  <div class="absolute top-[16px] right-[16px] w-[36px] h-[36px] rounded-full bg-white/20 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none shadow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8M3 16.2V21m0 0h4.8M3 21l6-6M21 7.8V3m0 0h-4.8M21 3l-6 6M3 7.8V3m0 0h4.8M3 3l6 6"/></svg>
                  </div>

                  <div class="absolute left-[20px] bottom-[20px] right-[20px] text-white">
                    <div class="font-heading font-bold text-[22px] lg:text-[24px] tracking-[-0.01em]">
                      {category.label}
                    </div>
                    {category.description && (
                      <p class="mt-[4px] text-[12px] lg:text-[13px] leading-[20px] text-white/80 max-w-[320px]">
                        {category.description}
                      </p>
                    )}
                  </div>
                  {category.images.length > 1 && (
                    <div class="absolute right-[16px] bottom-[16px] flex gap-[8px]">
                      <button
                        type="button"
                        data-gallery-prev
                        aria-label={`Previous ${category.label} image`}
                        class="w-[36px] h-[36px] rounded-full bg-white/20 backdrop-blur text-white flex items-center justify-center hover:bg-white/40 transition-colors"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                      </button>
                      <button
                        type="button"
                        data-gallery-next
                        aria-label={`Next ${category.label} image`}
                        class="w-[36px] h-[36px] rounded-full bg-white/20 backdrop-blur text-white flex items-center justify-center hover:bg-white/40 transition-colors"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                      </button>
                    </div>
                  )}
                </div>
              ))}
            </div>
            <p class="mt-[20px] text-right text-[11px] lg:text-[12px] text-[#10183B]/50">
              Artist's impressions are for representational purposes only.
            </p>
          </div>
        </section>
      )
    }

    <!-- CTA BANNER -->
    <section class="relative overflow-hidden">
      {
        project.ctaImage && (
          <img
            src={project.ctaImage}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        )
      }
      <div class="absolute inset-0 bg-[#10183B]/55"></div>
      <div
        data-reveal-group
        class="relative w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[72px] lg:py-[140px]"
      >
        <h2
          data-reveal-title
          class="font-serif text-white text-[32px] leading-[40px] md:text-[44px] md:leading-[54px] lg:text-[60px] lg:leading-[68px] tracking-[-0.01em]"
        >
          Interested in {project.title}?
        </h2>
        <p
          data-reveal-text
          class="mt-[16px] max-w-[480px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-white/80"
        >
          Share your details and our sales team will contact you with
          availability, floor plans and the latest project information.
        </p>
        <a
          data-reveal-btn
          href={`/contact?interest=${encodeURIComponent(project.title)}`}
          class="mt-[28px] inline-flex no-underline items-center gap-[12px] h-[52px] pl-[24px] pr-[6px] rounded-full bg-white text-[14px] font-medium text-[#10183B] hover:bg-[var(--color-cream)] transition-colors"
        >
          Submit an Enquiry
          <span
            class="w-[40px] h-[40px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </section>
