<script>
  const journeyCarousel = document.getElementById("journey-carousel");
  const journeyDots = document.querySelectorAll("[data-journey-dot]");
  if (journeyCarousel && journeyDots.length) {
    journeyCarousel.addEventListener(
      "scroll",
      () => {
        const active = Math.round(
          journeyCarousel.scrollLeft / journeyCarousel.clientWidth,
        );
        journeyDots.forEach((dot, i) => {
          dot.classList.toggle("bg-[var(--color-navy)]", i === active);
          dot.classList.toggle("bg-[#C9CEDD]", i !== active);
        });
      },
      { passive: true },
    );
  }
</script>
