---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import TiltCards from "../components/TiltCards.astro";

const arrowSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>';
---

<Layout>
  <Navbar slot="navbar" variant="light" />

  <main class="bg-[var(--color-cream)] text-[#10183B] overflow-x-clip">
    <!-- HERO - Our Story -->
    <section id="our-story" class="relative">
      <!-- Faint isometric blueprint line art -->
      <svg
        aria-hidden="true"
        class="absolute top-[40px] right-[-60px] w-[420px] lg:w-[640px] text-[var(--color-navy)] opacity-[0.05] pointer-events-none select-none"
        viewBox="0 0 640 560"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <g>
          <path d="M160 20 L320 112 L320 297 L160 389 L0 297 L0 112 Z"></path>
          <path d="M160 20 L160 205 M0 112 L160 205 L320 112 M160 205 L320 297"
          ></path>
        </g>
        <g transform="translate(320 120)">
          <path d="M160 20 L320 112 L320 297 L160 389 L0 297 L0 112 Z"></path>
          <path d="M160 20 L160 205 M0 112 L160 205 L320 112 M160 205 L320 297"
          ></path>
        </g>
        <g transform="translate(160 260)">
          <path d="M160 20 L320 112 L320 297 L160 389 L0 297 L0 112 Z"></path>
          <path d="M160 20 L160 205 M0 112 L160 205 L320 112 M160 205 L320 297"
          ></path>
        </g>
      </svg>

      <div
        class="relative z-10 w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pt-[140px] lg:pt-[180px] pb-[72px] lg:pb-[120px]"
      >
        <div class="lg:grid lg:grid-cols-2 lg:gap-[64px] lg:items-start">
          <!-- Left: copy -->
          <div data-reveal-group>
            <span
              data-reveal-text
              class="inline-flex w-fit items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
            >
              <span
                class="w-[6px] h-[6px] rounded-full bg-[var(--color-yellow)]"
              ></span>
              Our Story
            </span>
            <h1
              data-reveal-title
              class="mt-[24px] lg:mt-[32px] font-heading font-bold text-[34px] leading-[42px] md:text-[44px] md:leading-[52px] lg:text-[56px] lg:leading-[66px] tracking-[-0.02em] text-[#10183B]"
            >
              Built Across Generations.
            </h1>
            <p
              data-reveal-text
              class="hidden lg:block mt-[20px] lg:mt-[28px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/70 max-w-[520px]"
            >
              Hindustan Developers is a Goa-based, family-led company built on
              more than five decades of practical construction experience. What
              began as a contracting business has grown into a development
              company committed to creating dependable, thoughtfully designed
              homes.
            </p>
            <a
              data-reveal-btn
              href="#journey"
              class="mt-[28px] lg:mt-[36px] inline-flex w-fit no-underline items-center gap-[14px] h-[48px] pl-6 pr-[6px] rounded-full bg-[#FFFCF7] border border-[#C9CEDD] text-[#10183B] text-[14px] font-medium hover:bg-[var(--color-yellow)] transition-colors group"
            >
              Our Journey
              <span
                class="w-[36px] h-[36px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center flex-shrink-0 group-hover:bg-[#1b2452] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                    points="7 7 17 7 17 17"></polyline></svg
                >
              </span>
            </a>
          </div>

          <!-- Right: photo + stat cards -->
          <div class="mt-[48px] lg:mt-0">
            <div class="rounded-[24px] overflow-hidden">
              <img
                data-reveal-img
                src="/images/construction-workers.png"
                alt="The Hindustan Developers team on site"
                class="w-full aspect-[4/3] lg:aspect-[16/10] object-cover"
                loading="eager"
              />
            </div>
            <div
              data-reveal-cards
              class="mt-[16px] lg:mt-[20px] grid grid-cols-1 lg:grid-cols-2 gap-[16px] lg:gap-[20px]"
            >
              <!-- Navy stat card -->
              <div
                data-reveal-card
                class="tilt-card rounded-[24px] bg-[var(--color-navy)] text-white p-[24px] lg:p-[28px]"
              >
                <div
                  class="text-[11px] font-medium uppercase tracking-[0.18em] text-white/60"
                >
                  Project Completed
                </div>
                <div
                  class="mt-[14px] font-heading font-bold text-[40px] lg:text-[48px] leading-none"
                >
                  <span data-counter class="hidden lg:inline">100 +</span>
                  <span data-counter class="lg:hidden">1,500 +</span>
                </div>
                <p class="mt-[14px] text-[12px] leading-[20px] text-white/65">
                  Successfully delivering projects across commercial,
                  residential, and industrial sectors.
                </p>
              </div>
              <!-- White stat card -->
              <div
                data-reveal-card
                class="tilt-card rounded-[24px] bg-[var(--color-card)] text-[#10183B] p-[24px] lg:p-[28px]"
              >
                <div
                  class="text-[11px] font-medium uppercase tracking-[0.18em] text-[#10183B]/50"
                >
                  Industry experience
                </div>
                <div
                  class="mt-[14px] font-heading font-bold text-[40px] lg:text-[48px] leading-none"
                >
                  <span class="hidden lg:inline"
                    ><span data-counter>50</span> Years</span
                  >
                  <span class="lg:hidden"
                    ><span data-counter>20</span> Years</span
                  >
                </div>
                <p
                  class="mt-[14px] text-[12px] leading-[20px] text-[#10183B]/60"
                >
                  <span class="hidden lg:inline"
                    >Five decades of on-ground experience inform every stage of
                    planning and execution.</span
                  >
                  <span class="lg:hidden"
                    >Years of hands on construction knowledge across diverse
                    projects.</span
                  >
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- JOURNEY -->
    <section id="journey" class="scroll-mt-[90px]">
      <div
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[72px] lg:py-[120px]"
      >
        <div class="flex flex-col items-center text-center" data-reveal-group>
          <span
            data-reveal-text
            class="inline-flex w-fit items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
          >
            <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-yellow)]"
            ></span>
            Our Journey
          </span>
          <h2
            data-reveal-title
            class="mt-[24px] lg:mt-[32px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em] text-[#10183B] max-w-[720px]"
          >
            From Building for Others to Building Our Own
          </h2>
        </div>

        <div
          class="mt-[40px] lg:mt-[64px] tilt-card rounded-[24px] bg-[var(--color-card)] p-[24px] lg:p-[56px]"
          data-reveal-card
        >
          <div class="lg:flex lg:gap-[56px] lg:items-center">
            <!-- Text + timeline -->
            <div class="lg:w-[55%] order-2 lg:order-1 mt-[28px] lg:mt-0">
              <!-- Desktop timeline -->
              <div class="hidden lg:block">
                <div class="flex gap-[28px]">
                  <div class="flex flex-col items-center pt-[8px]">
                    <div
                      class="w-[14px] h-[14px] rounded-[4px] bg-[var(--color-navy)]"
                    >
                    </div>
                    <div class="w-[2px] flex-1 bg-[#D8D3CC] my-[8px]"></div>
                  </div>
                  <div class="pb-[36px]">
                    <div
                      class="text-[12px] font-semibold uppercase tracking-[0.14em] text-[var(--color-navy)] mb-[14px]"
                    >
                      Then
                    </div>
                    <p class="text-[15px] leading-[28px] text-[#10183B]/70">
                      The Hindustan story began over <strong
                        class="font-semibold text-[#10183B]"
                        >50 years ago</strong
                      >, when Rafik Chowhan's father established the family's
                      contracting business. Over the decades, the company earned
                      experience by contributing to residential developments for
                      some of Goa's established builders.
                    </p>
                    <p
                      class="mt-[18px] text-[15px] leading-[28px] text-[#10183B]/70"
                    >
                      <strong class="font-semibold text-[#10183B]"
                        >Rafik Chowhan</strong
                      > carried that
                      <strong class="font-semibold text-[#10183B]"
                        >legacy</strong
                      > forward, strengthening the company's understanding of construction,
                      materials, execution and the realities of delivering homes well.
                      Today, he leads Hindustan Developers into its next chapter as
                      a developer.
                    </p>
                  </div>
                </div>
                <div class="flex gap-[28px]">
                  <div class="flex flex-col items-center pt-[8px]">
                    <div
                      class="w-[14px] h-[14px] rounded-[4px] bg-[var(--color-navy)]"
                    >
                    </div>
                  </div>
                  <div>
                    <div
                      class="text-[12px] font-semibold uppercase tracking-[0.14em] text-[var(--color-navy)] mb-[14px]"
                    >
                      Now
                    </div>
                    <p class="text-[15px] leading-[28px] text-[#10183B]/70">
                      This evolution is rooted in experience rather than
                      reinvention. The same construction knowledge that
                      supported landmark residential projects across Goa now
                      guides homes developed under the Hindustan name.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Mobile/tablet paragraphs -->
              <div class="lg:hidden">
                <p class="text-[14px] leading-[26px] text-[#10183B]/70">
                  The Hindustan story began over <strong
                    class="font-semibold text-[#10183B]">50 years ago</strong
                  >, when Rafik Chowhan's father established the family's
                  contracting business. Over the decades, the company earned
                  experience by contributing to residential developments for
                  some of Goa's established builders.
                </p>
                <p
                  class="mt-[16px] text-[14px] leading-[26px] text-[#10183B]/70"
                >
                  <strong class="font-semibold text-[#10183B]"
                    >Rafik Chowhan</strong
                  > carried that 
                  <strong class="font-semibold text-[#10183B]"> legacy</strong> forward,
                  strengthening the company's understanding of construction, materials,
                  execution and the realities of delivering homes well. Today, he
                  leads Hindustan Developers into its next chapter as a developer.
                </p>
                <p
                  class="mt-[16px] text-[14px] leading-[26px] text-[#10183B]/70"
                >
                  This evolution is rooted in experience rather than
                  reinvention. The same construction knowledge that supported
                  landmark residential projects across Goa now guides homes
                  developed under the Hindustan name.
                </p>
              </div>
            </div>

            <!-- Image -->
            <div class="lg:w-[45%] order-1 lg:order-2">
              <div class="rounded-[24px] overflow-hidden">
                <img
                  data-reveal-img
                  src="/images/blueprint-planning.webp"
                  alt="Planning a project over blueprints"
                  class="w-full aspect-[4/3] object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LEADERSHIP -->
    <section id="leadership" class="scroll-mt-[90px]">
      <div
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[72px] lg:py-[120px]"
      >
        <div class="flex justify-center" data-reveal-group>
          <span
            data-reveal-text
            class="inline-flex w-fit items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
          >
            <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-yellow)]"
            ></span>
            Leadership
          </span>
        </div>

        <div
          class="mt-[32px] lg:mt-[56px] lg:grid lg:grid-cols-12 lg:gap-[48px] xl:gap-[64px] lg:items-center"
        >
          <!-- Left column: Story & Pillars -->
          <div
            class="lg:col-span-7 flex flex-col items-start"
            data-reveal-group
          >
            <h2
              data-reveal-title
              class="font-heading font-bold text-[30px] leading-[38px] md:text-[40px] md:leading-[48px] lg:text-[50px] lg:leading-[58px] tracking-[-0.02em] text-[#10183B]"
            >
              Leading the Next Chapter
            </h2>
            <p
              data-reveal-text
              class="mt-[20px] lg:mt-[24px] text-[15px] lg:text-[16px] leading-[28px] lg:leading-[30px] text-[#10183B]/75 max-w-[640px]"
            >
              Rafik Chowhan represents the second generation of the family's
              construction legacy. Having carried the contracting business
              forward, he now leads its transition into property
              development-bringing decades of technical understanding and
              on-site experience to a new generation of homes in Goa.
            </p>
            <p
              data-reveal-text
              class="mt-[16px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/65 max-w-[640px]"
            >
              This evolution is grounded in hands-on building discipline rather
              than distant oversight. Every project reflects a deep respect for
              materials, precision in craftsmanship, and a genuine commitment to
              delivering enduring quality.
            </p>

            <!-- Leadership Highlights -->
            <div
              data-reveal-cards
              class="mt-[28px] lg:mt-[36px] grid grid-cols-1 sm:grid-cols-3 gap-[14px] w-full max-w-[640px]"
            >
              <div
                data-reveal-card
                class="tilt-card rounded-[18px] bg-[var(--color-card)] border border-[#EBE7DF] p-[18px]"
              >
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-navy)]/60"
                >
                  Legacy
                </div>
                <div class="mt-[6px] text-[15px] font-bold text-[#10183B]">
                  50+ Years Heritage
                </div>
              </div>
              <div
                data-reveal-card
                class="tilt-card rounded-[18px] bg-[var(--color-card)] border border-[#EBE7DF] p-[18px]"
              >
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-navy)]/60"
                >
                  Stewardship
                </div>
                <div class="mt-[6px] text-[15px] font-bold text-[#10183B]">
                  2nd Generation
                </div>
              </div>
              <div
                data-reveal-card
                class="tilt-card rounded-[18px] bg-[var(--color-card)] border border-[#EBE7DF] p-[18px]"
              >
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-navy)]/60"
                >
                  Execution
                </div>
                <div class="mt-[6px] text-[15px] font-bold text-[#10183B]">
                  On-Site Mastery
                </div>
              </div>
            </div>
          </div>

          <!-- Right column: Executive Director Card -->
          <div class="mt-[36px] lg:mt-0 lg:col-span-5 w-full" data-reveal-card>
            <div
              class="tilt-card relative rounded-[24px] bg-[var(--color-navy)] text-white p-[32px] lg:p-[40px] overflow-hidden flex flex-col justify-between min-h-[380px] shadow-[0_20px_50px_rgba(16,24,59,0.12)] border border-[#232B54]"
            >
              <!-- Faint architectural geometry art in card background -->
              <svg
                aria-hidden="true"
                class="absolute -top-10 -right-10 w-[240px] h-[240px] text-white/5 pointer-events-none select-none"
                viewBox="0 0 200 200"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M100 15 L185 65 L185 165 L100 215 L15 165 L15 65 Z"
                ></path>
                <path
                  d="M100 15 L100 115 M15 65 L100 115 L185 65 M100 115 L185 165"
                ></path>
                <circle cx="100" cy="115" r="45" stroke-dasharray="3 3"
                ></circle>
              </svg>

              <div>
                <div
                  class="inline-flex items-center gap-[8px] px-[14px] h-[32px] rounded-full bg-white/10 border border-white/15 text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--color-yellow)]"
                >
                  <span
                    class="w-[6px] h-[6px] rounded-full bg-[var(--color-yellow)]"
                  ></span>
                  Director
                </div>

                <h3
                  class="font-heading font-bold text-[28px] lg:text-[34px] leading-tight text-white mt-[18px] tracking-[-0.01em]"
                >
                  Rafik Chowhan
                </h3>
                <p class="text-white/60 text-[14px] mt-[4px]">
                  Hindustan Developers
                </p>

                <div class="mt-[24px] pt-[24px] border-t border-white/10">
                  <p
                    class="text-white/75 text-[14px] leading-[24px] italic font-serif"
                  >
                    "Carrying forward five decades of practical construction
                    mastery into modern, enduring residential spaces for Goa."
                  </p>
                </div>
              </div>

              <div
                class="mt-[32px] pt-[24px] border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-[16px]"
              >
                <span
                  class="text-white/50 text-[12px] uppercase tracking-[0.14em] font-medium"
                >
                  Connect
                </span>
                <div class="flex items-center gap-[10px]">
                  <a
                    href="#"
                    aria-label="Instagram"
                    class="inline-flex items-center gap-[8px] h-[40px] px-[16px] rounded-full bg-white/10 hover:bg-[var(--color-yellow)] hover:text-[#10183B] border border-white/15 text-white text-[13px] font-medium no-underline transition-all group"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      ><rect
                        x="2"
                        y="2"
                        width="20"
                        height="20"
                        rx="5"
                        ry="5"
                        stroke="currentColor"
                        stroke-width="2"></rect><path
                        d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                        stroke="currentColor"
                        stroke-width="2"></path><line
                        x1="17.5"
                        y1="6.5"
                        x2="17.51"
                        y2="6.5"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"></line></svg
                    >
                    <span>Instagram</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="opacity-70 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                      ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                        points="7 7 17 7 17 17"></polyline></svg
                    >
                  </a>
                  <a
                    href="#"
                    aria-label="LinkedIn"
                    class="inline-flex items-center gap-[8px] h-[40px] px-[16px] rounded-full bg-white/10 hover:bg-[var(--color-yellow)] hover:text-[#10183B] border border-white/15 text-white text-[13px] font-medium no-underline transition-all group"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      ><path
                        d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"
                      ></path></svg
                    >
                    <span>LinkedIn</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="opacity-70 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                      ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                        points="7 7 17 7 17 17"></polyline></svg
                    >
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VISION & MISSION -->
    <section id="vision" class="scroll-mt-[90px]">
      <div
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[72px] lg:py-[120px]"
      >
        <div class="flex flex-col items-center text-center" data-reveal-group>
          <span
            data-reveal-text
            class="inline-flex w-fit items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
          >
            <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-yellow)]"
            ></span>
            Our Direction
          </span>
          <h2
            data-reveal-title
            class="mt-[24px] lg:mt-[32px] font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em] text-[#10183B]"
          >
            Our Vision and Mission
          </h2>
        </div>

        <div
          class="mt-[40px] lg:mt-[64px] grid grid-cols-1 lg:grid-cols-2 gap-[16px] lg:gap-[24px]"
          data-reveal-cards
        >
          <!-- Vision card -->
          <div
            data-reveal-card
            class="tilt-card relative rounded-[24px] bg-[var(--color-card)] p-[28px] lg:p-[40px] overflow-hidden flex flex-col min-h-[260px] lg:min-h-[320px]"
          >
            <div
              class="absolute top-[24px] right-[24px] flex gap-[6px] opacity-30"
              aria-hidden="true"
            >
              <span class="w-[8px] h-[8px] rounded-full bg-[var(--color-navy)]"
              ></span>
              <span class="w-[8px] h-[8px] rounded-full bg-[var(--color-navy)]"
              ></span>
              <span class="w-[8px] h-[8px] rounded-full bg-[var(--color-navy)]"
              ></span>
            </div>
            <div
              class="w-[52px] h-[52px] rounded-[14px] border border-[var(--color-navy)]/30 flex items-center justify-center text-[var(--color-navy)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
