---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import TiltCards from "../components/TiltCards.astro";

const inputClass =
  "w-full h-[48px] bg-white border border-[#D9D6D2] rounded-[10px] px-[16px] text-[14px] text-[var(--color-navy)] placeholder:text-[#A6ACBC] outline-none focus:border-[var(--color-navy)] transition-colors";
const labelClass =
  "block text-[13px] font-medium text-[var(--color-navy)] mb-[8px]";

const infoCards = [
  {
    label: "Sales Office",
    value: "4th Floor, Shabana Chambers, Municipal Market, Panaji, Goa 403001",
    href: null,
    icon: "building",
  },
  {
    label: "Phone",
    value: "+91 84839 51977",
    href: "tel:+918483951977",
    icon: "phone",
  },
  {
    label: "Email",
    value: "hindustandevelopers@hotmail.com",
    href: "mailto:hindustandevelopers@hotmail.com",
    icon: "mail",
  },
];
---

<Layout
  title="Contact – Hindustan Developers"
  description="Speak with the Hindustan Developers team about Serene Meadows — availability, floor plans, pricing and site visits."
>
  <Navbar variant="light" />

  <main class="bg-[var(--color-cream)] text-[#10183B] overflow-x-clip">
    <!-- CONTACT — Let's Talk About Your Next Home -->
    <section id="contact-us" class="relative">
      <div
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pt-[140px] lg:pt-[180px] pb-[72px] lg:pb-[120px]"
      >
        <div class="lg:grid lg:grid-cols-2 lg:gap-[60px]">
          <!-- Heading block -->
          <div class="lg:col-start-1 lg:row-start-1" data-reveal-group>
            <span
              data-reveal-text
              class="inline-flex w-fit items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
            >
              <span class="w-[6px] h-[6px] rounded-full bg-[var(--color-navy)]"
              ></span>
              Get in Touch
            </span>
            <h1
              data-reveal-title
              class="mt-[24px] lg:mt-[32px] font-heading font-bold text-[34px] leading-[42px] md:text-[44px] md:leading-[52px] lg:text-[56px] lg:leading-[66px] tracking-[-0.02em] text-[#10183B]"
            >
              Let's Talk About Your Next Home
            </h1>
            <p
              data-reveal-text
              class="mt-[20px] lg:mt-[28px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-[#10183B]/70 max-w-[520px]"
            >
              Whether you are considering Serene Meadows as a family home,
              second home or investment, share your details and our team will
              help you with the information you need.
            </p>
          </div>

          <!-- Enquiry form -->
          <form
            id="enquiry-form"
            data-reveal-card
            class="mt-[40px] lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 bg-white rounded-[24px] border border-[#10183B]/5 shadow-[0_8px_30px_rgba(16,24,59,0.06)] p-[24px] lg:p-[40px]"
          >
            <div class="space-y-[20px] lg:space-y-[24px]">
              <div>
                <label for="field-name" class={labelClass}
                  >Name<span class="text-[#C0392B]">*</span></label
                >
                <input
                  id="field-name"
                  name="name"
                  type="text"
                  required
                  placeholder="Jane Smith"
                  class={inputClass}
                />
              </div>

              <div class="grid grid-cols-2 gap-[14px] lg:gap-[20px]">
                <div>
                  <label for="field-phone" class={labelClass}
                    >Phone number<span class="text-[#C0392B]">*</span></label
                  >
                  <input
                    id="field-phone"
                    name="phone"
                    type="tel"
                    required
                    placeholder="+91 98765 43210"
                    class={inputClass}
                  />
                </div>
                <div>
                  <label for="field-email" class={labelClass}
                    >Email<span class="text-[#C0392B]">*</span></label
                  >
                  <input
                    id="field-email"
                    name="email"
                    type="email"
                    required
                    placeholder="jane@example.com"
                    class={inputClass}
                  />
                </div>
              </div>

              <div>
                <label for="field-city" class={labelClass}>
                  Current City <sup
                    class="text-[11px] font-normal text-[#9BA0AE]">Optional</sup
                  >
                </label>
                <input
                  id="field-city"
                  name="city"
                  type="text"
                  placeholder="Panaji, Goa"
                  class={inputClass}
                />
              </div>

              <div>
                <label for="field-interest" class={labelClass}
                  >Interested In</label
                >
                <div class="relative">
                  <select
                    id="field-interest"
                    name="interest"
                    class:list={[inputClass, "appearance-none"]}
                  >
                    <option>2 BHK at Serene Meadows</option>
                    <option>3 BHK at Serene Meadows</option>
                    <option>General Enquiry</option>
                    <option>Business Enquiry</option>
                  </select>
                  <svg
                    class="absolute right-[16px] top-1/2 -translate-y-1/2 pointer-events-none text-[#A6ACBC]"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="6 9 12 15 18 9"></polyline></svg
                  >
                </div>
              </div>

              <div>
                <label for="field-contact-method" class={labelClass}
                  >Preferred Contact Method</label
                >
                <div class="relative">
                  <select
                    id="field-contact-method"
                    name="contactMethod"
                    class:list={[inputClass, "appearance-none"]}
                  >
                    <option>Phone</option>
                    <option>WhatsApp</option>
                    <option>Email</option>
                  </select>
                  <svg
                    class="absolute right-[16px] top-1/2 -translate-y-1/2 pointer-events-none text-[#A6ACBC]"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="6 9 12 15 18 9"></polyline></svg
                  >
                </div>
              </div>

              <div class="pt-[4px]">
                <button
                  id="enquiry-submit"
                  type="submit"
                  class="inline-flex items-center gap-[10px] h-[48px] pl-6 pr-[6px] rounded-full bg-[var(--color-navy)] text-white text-[14px] font-medium hover:bg-[#1b2452] transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="enquiry-submit-label">Send Enquiry</span>
                  <span
                    class="w-[36px] h-[36px] rounded-full bg-white text-[var(--color-navy)] flex items-center justify-center flex-shrink-0"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                        points="12 5 19 12 12 19"></polyline></svg
                    >
                  </span>
                </button>

                <label
                  class="mt-[20px] flex items-start gap-[10px] cursor-pointer"
                >
                  <input
                    type="checkbox"
                    name="consent"
                    required
                    class="mt-[2px] w-[16px] h-[16px] accent-[var(--color-navy)] flex-shrink-0"
                  />
                  <span class="text-[12px] leading-[20px] text-[#10183B]/65">
                    I agree to be contacted by Hindustan Constructions regarding
                    this enquiry.
                  </span>
                </label>

                <p
                  id="enquiry-status"
                  class="hidden mt-[16px] text-[13px] leading-[20px]"
                  role="status"
                  aria-live="polite"
                >
                </p>
              </div>
            </div>
          </form>

          <!-- Info cards -->
          <div
            data-reveal-cards
            class="mt-[40px] lg:mt-[48px] lg:col-start-1 lg:row-start-2 flex flex-col gap-[14px] lg:gap-[16px]"
          >
            {
              infoCards.map((card) => (
                <div data-reveal-card class="tilt-card relative rounded-[24px] bg-white border border-[#10183B]/5 shadow-[0_8px_30px_rgba(16,24,59,0.06)] p-[24px] lg:p-[28px] flex flex-col min-h-[160px] lg:min-h-[180px]">
                  <div
                    class="absolute top-[24px] right-[24px]"
                    aria-hidden="true"
                  >
                    <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
                      <g fill="var(--color-navy)" opacity="0.25">
                        <circle cx="13" cy="3" r="3" />
                        <circle cx="3" cy="13" r="3" />
                        <circle cx="23" cy="13" r="3" />
                        <circle cx="13" cy="23" r="3" />
                      </g>
                    </svg>
                  </div>
                  <span class="inline-flex w-fit items-center gap-[10px] h-[40px] px-[16px] rounded-full border border-[var(--color-navy)]/25 text-[#10183B] text-[13px] font-semibold">
                    {card.icon === "building" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="4" y="2" width="16" height="20" rx="2" />
                        <path d="M9 22v-4h6v4" />
                        <path d="M8 6h.01" />
                        <path d="M16 6h.01" />
                        <path d="M12 6h.01" />
                        <path d="M12 10h.01" />
                        <path d="M12 14h.01" />
                        <path d="M16 10h.01" />
                        <path d="M16 14h.01" />
                        <path d="M8 10h.01" />
                        <path d="M8 14h.01" />
                      </svg>
                    )}
                    {card.icon === "phone" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                      </svg>
                    )}
                    {card.icon === "mail" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                      </svg>
                    )}
                    {card.label}
                  </span>
                  {card.href ? (
                    <a
                      href={card.href}
                      class="mt-auto pt-[32px] no-underline font-heading font-semibold text-[16px] lg:text-[18px] leading-[26px] text-[#10183B] hover:text-[var(--color-navy-mid)] transition-colors break-all"
                    >
                      {card.value}
                    </a>
                  ) : (
                    <p class="mt-auto pt-[32px] font-heading font-semibold text-[16px] lg:text-[18px] leading-[26px] text-[#10183B]">
                      {card.value}
                    </p>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- CTA — Speak with Our Team -->
    <section
      id="contact-cta"
      class="relative min-h-[70vh] flex items-start overflow-hidden"
    >
      <img
        src="/images/inquiry-section-bg-image.png"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
      <div
        class="absolute inset-0 bg-[var(--color-navy)]/80 bg-gradient-to-t from-[#10183B] via-[#10183B]/70 to-[#10183B]/40"
      >
      </div>
      <div
        data-reveal-group
        class="relative z-10 w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[80px] lg:py-[120px]"
      >
        <h2
          data-reveal-title
          class="font-heading font-bold text-[30px] leading-[38px] md:text-[38px] md:leading-[46px] lg:text-[48px] lg:leading-[56px] tracking-[-0.02em] text-white max-w-[640px]"
        >
          Speak with Our Team
        </h2>
        <p
          data-reveal-text
          class="mt-[16px] lg:mt-[20px] text-[14px] lg:text-[15px] leading-[26px] lg:leading-[28px] text-white/70 max-w-[520px]"
        >
          Contact us for current availability, floor plans, pricing and
          site-visit information for Serene Meadows.
        </p>
        <div
          data-reveal-btn
          class="mt-[28px] lg:mt-[36px] flex items-center gap-[24px] flex-wrap"
        >
          <a
            href="tel:+918483951977"
            class="inline-flex w-fit no-underline items-center gap-[14px] h-[48px] pl-6 pr-[6px] rounded-full bg-[#FFFCF7] text-[#10183B] text-[14px] font-medium hover:bg-[var(--color-yellow)] transition-colors group"
          >
            Call Now
            <span
              class="w-[36px] h-[36px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center flex-shrink-0 group-hover:bg-[#1b2452] transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                  points="7 7 17 7 17 17"></polyline></svg
              >
            </span>
          </a>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Shabana+Chambers+Municipal+Market+Panaji+Goa+403001"
            target="_blank"
            rel="noopener"
            class="text-white text-[14px] font-normal underline underline-offset-4 decoration-white/60 hover:text-[var(--color-yellow)] hover:decoration-[var(--color-yellow)] transition-colors"
          >
            Get Directions
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // TODO: replace with your Formspree / Web3Forms endpoint
  const FORM_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";

  const form = document.getElementById(
    "enquiry-form",
  ) as HTMLFormElement | null;
  const submitBtn = document.getElementById(
    "enquiry-submit",
  ) as HTMLButtonElement | null;
  const submitLabel = document.getElementById("enquiry-submit-label");
  const statusEl = document.getElementById("enquiry-status");

  function showStatus(message: string, ok: boolean) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "text-[#1E7E34]", "text-[#C0392B]");
    statusEl.classList.add(ok ? "text-[#1E7E34]" : "text-[#C0392B]");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !submitBtn) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = "Sending…";

    try {
      const response = await fetch(FORM_ENDPOINT, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        showStatus(
          "Thank you — your enquiry has been sent. Our team will reach out shortly.",
          true,
        );
        form.reset();
      } else {
        showStatus(
          "Something went wrong while sending your enquiry. Please try again or call us directly.",
          false,
        );
      }
    } catch (error) {
      showStatus(
        "Something went wrong while sending your enquiry. Please try again or call us directly.",
        false,
      );
    } finally {
      submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = "Send Enquiry";
    }
  });
</script>

<TiltCards />
