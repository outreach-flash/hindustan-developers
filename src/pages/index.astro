              class="flex flex-col items-center text-center gap-5 w-[45%] md:w-1/4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="36"
                height="36"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#c7a469"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
