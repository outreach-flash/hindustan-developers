        <img
          src={encodeURI(
            displayFeatured.coverImage ||
              "/images/projects/serene-meadows/View 01 v03.webp",
          )}
          alt={displayFeatured.title}
          class="absolute left-0 w-full h-[130%] top-[-15%] object-cover"
          data-speed="0.8"
        />
        <div
          class="absolute top-0 right-0 bg-[#c7a469] text-white p-8 md:p-12 max-w-sm shadow-xl"
          data-reveal-item
        >
          <div
            class="text-xs font-bold tracking-[0.2em] uppercase opacity-90 mb-3"
          >
            Starting from
          </div>
          <div class="font-serif text-4xl md:text-5xl mb-3 tracking-tight">
