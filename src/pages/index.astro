                ></path><polyline points="9 22 9 12 15 12 15 22"
                ></polyline></svg
              >
              <span
                class="text-[11px] font-bold tracking-[0.15em] uppercase text-[#1a1c1a] leading-relaxed"
                >Long Term<br />Value</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right side (Mission/Vision) -->
      <div
        class="w-full lg:w-5/12 bg-[var(--color-dark-section)] flex justify-start border-t lg:border-t-0 lg:border-l border-white/5"
      >
        <div
