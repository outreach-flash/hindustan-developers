<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Register the plugin
  gsap.registerPlugin(ScrollTrigger);

  // START: Parallax Animations (desktop only — disabled on touch/mobile to prevent
  // scroll jumps and content clipping caused by mobile browser viewport resize events)
  const isDesktop = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  ).matches;

  const heroBg = document.getElementById("hero-bg");
  const heroSection = document.getElementById("hero-section");

  if (isDesktop && heroSection && heroBg) {
    gsap.to(heroBg, {
      yPercent: 40,
      ease: "none",
      scrollTrigger: {
        trigger: heroSection,
        start: "top top",
        end: "bottom top",
        scrub: 0.5,
      },
    });
  }

  // Goa Map Section Parallax
  const mapSection = document.getElementById("goa-map-section");
  const mapImg = document.getElementById("goa-map-img");
  if (isDesktop && mapSection && mapImg) {
    gsap.to(mapImg, {
      yPercent: 30,
      ease: "none",
      scrollTrigger: {
        trigger: mapSection,
        start: "top bottom",
        end: "bottom top",
        scrub: 0.5,
      },
    });
  }

  // Contact Section Background Parallax
  const contactSection = document.getElementById("contact");
  const contactBg = document.getElementById("contact-bg");
  if (isDesktop && contactSection && contactBg) {
    gsap.to(contactBg, {
      yPercent: 40,
      ease: "none",
      scrollTrigger: {
        trigger: contactSection,
        start: "top top",
        end: "bottom top",
        scrub: 0.5,
      },
    });
  }
  // END: Parallax Animations

  // START: 3D Tilt Hover for Cards (desktop pointer only)
  if (isDesktop) {
    document.querySelectorAll(".tilt-card").forEach((card) => {
      const el = card as HTMLElement;
      el.style.transformStyle = "preserve-3d";
      el.style.willChange = "transform";
      el.style.transition = "transform 0.15s ease-out";
      el.addEventListener("mousemove", (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        el.style.transform = `perspective(800px) rotateX(${(-py * 10).toFixed(2)}deg) rotateY(${(px * 12).toFixed(2)}deg) scale(1.02)`;
      });
      el.addEventListener("mouseleave", () => {
        el.style.transition = "transform 0.4s ease-out";
        el.style.transform =
          "perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)";
        setTimeout(
          () => (el.style.transition = "transform 0.15s ease-out"),
          400,
        );
      });
    });
  }
  // END: 3D Tilt Hover for Cards

  // START: Scroll Breakpoints for Nav Style
  // Use a plain scroll listener instead of a GSAP ScrollTrigger on document.body,
  // which caused unwanted scroll-to-top resets on mobile.
  const navInner = document.getElementById("nav-inner");
  function updateNavStyle() {
    const scrollY = window.scrollY;
    const vh = window.innerHeight;
    if (scrollY >= vh && scrollY < vh * 2) {
      gsap.set(navInner, {
        backgroundColor: "var(--color-navy)",
        color: "var(--color-white)",
      });
    } else if (scrollY < vh) {
      gsap.set(navInner, { backgroundColor: "", color: "" });
    }
    // Additional breakpoints can be added here
  }
  window.addEventListener("scroll", updateNavStyle, { passive: true });
  updateNavStyle(); // run once on load
  // END: Scroll Breakpoints for Nav Style
</script>
