              Lifestyle<br />Advantage
            </h4>
            <p class="text-white/70 text-[13px] leading-relaxed max-w-[180px]">
              Beaches, culture, safety and a relaxed yet vibrant lifestyle.
            </p>
          </div>
          <div
            class="flex flex-col items-center text-center col-span-2 md:col-span-1 lg:col-span-1"
            data-reveal-item
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="42"
              height="42"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#c7a469"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mb-6"
              ><path d="M12 2v20"></path><path
                d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
              ></path></svg
            >
            <h4
              class="text-[#c7a469] text-[11px] font-bold tracking-[0.15em] uppercase mb-4 leading-relaxed"
            >
              Strong<br />Investment Potential
            </h4>
            <p class="text-white/70 text-[13px] leading-relaxed max-w-[180px]">
              Capital appreciation and attractive rental yields.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- OUR PROJECTS (DYNAMIC) -->
    <section
      class="flex flex-col lg:flex-row w-full min-h-screen bg-[#f5f3ee]"
      data-reveal-group
      data-nav-theme="light"
    >
      <!-- Left side -->
      <div class="w-full lg:w-7/12 flex justify-end">
        <div
          class="w-full max-w-[760px] px-6 lg:pl-16 lg:pr-20 xl:pr-28 py-20 lg:py-32 flex flex-col justify-center"
        >
          <div
            class="text-[#c7a469] text-sm font-bold tracking-[0.2em] uppercase mb-6"
            data-reveal-item
          >
            Our Projects
          </div>
          <h2
            class="font-serif text-5xl lg:text-[64px] leading-[1.1] tracking-tight text-[#1a1c1a] mb-5"
            data-reveal-item
          >
            {displayFeatured.title}
          </h2>

          <div
            class="flex items-center gap-3 text-[#1a1c1a]/60 text-base mb-10 font-medium"
            data-reveal-item
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
