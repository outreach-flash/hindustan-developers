                xmlns="http://www.w3.org/2000/svg"
                width="36"
                height="36"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#c7a469"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 2v20"></path><path
                  d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                ></path></svg
              >
              <span
                class="text-[11px] font-bold tracking-[0.15em] uppercase text-[#1a1c1a] leading-relaxed"
                >Sustainable<br />Development</span
              >
            </div>
            <div
              class="flex flex-col items-center text-center gap-5 w-[45%] md:w-1/4"
            >
