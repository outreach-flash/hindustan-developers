                <div
                  class="flex flex-col items-center text-center gap-4"
                  data-reveal-item
                >
                  <div class="w-12 h-12 rounded-full border border-[#1a1c1a]/20 flex items-center justify-center">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#1a1c1a"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                  <span class="text-[11px] font-bold tracking-[0.15em] uppercase text-[#1a1c1a] leading-relaxed">
                    {detail.key}
                  </span>
                </div>
              ))
            }
          </div>

          <div class="flex flex-col sm:flex-row gap-5" data-reveal-item>
            <a
              href={featuredProjectSlug
                ? `/projects/${featuredProjectSlug}`
                : "/projects/serene-meadows"}
              class="inline-flex items-center justify-center gap-3 bg-[#c7a469] text-white font-bold text-[13px] tracking-[0.15em] uppercase px-10 py-5 hover:bg-[#b49157] transition-colors"
