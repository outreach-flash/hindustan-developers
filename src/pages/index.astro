---
export const prerender = true;
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const reader = createReader(process.cwd(), keystaticConfig);
let featuredProject = null;
let featuredProjectSlug = null;
let allProjects = [];
let legacyProjects = [];

try {
  const featured = await reader.singletons.featuredProject.read();
  if (featured?.projectSlug) {
    featuredProject = await reader.collections.projects.read(
      featured.projectSlug,
    );
    featuredProjectSlug = featuredProject ? featured.projectSlug : null;
  }
  const projects = await reader.collections.projects.all();
  allProjects = projects || [];
  const legacy = await reader.collections.legacyProjects.all();
  if (legacy && legacy.length) {
    legacyProjects = legacy
      .map(({ entry }) => entry)
      .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0));
  }
} catch (error) {}

const defaultFeatured = {
  title: "Serene Meadows",
  subtitle:
    "Serene Meadows is a gated community of 71 premium residences featuring spacious 2 and 3 BHK apartments, landscaped surroundings and amenities designed for a comfortable, connected life. With the heritage of Old Goa nearby and Panaji within easy reach, it brings together calm surroundings and everyday convenience.",
  location: "Kadamba Plateau, Goa",
  details: [
    { key: "Residences", value: "71 Premium" },
    { key: "Spacious", value: "63 2 BHK" },
    { key: "Elegant", value: "8 3 BHK" },
    { key: "Starting from", value: "₹ 1.05 Crores" },
  ],
};

const fallbackLegacyProjects = [
  {
    title: "Casa Kewals",
    location: "Anjuna, Goa",
    client: "Beera Home",
    image: "/images/projects/casa-kewals.png",
  },
  {
    title: "Vil Maris",
    location: "Assagao, Goa",
    client: "Ritesh Mehta",
    image: "/images/projects/vil-maris.png",
  },
  {
    title: "Casa De Amora",
    location: "Pilerne, Goa",
    client: "Anand Incorporation",
    image: "/images/projects/casa-de-amora.png",
  },
];

const displayFeatured = featuredProject || defaultFeatured;
const displayLegacy = legacyProjects.length
  ? legacyProjects
  : fallbackLegacyProjects;
---

<Layout>
  <Navbar variant="overlay" />

  <main>
    <!-- HERO — fixed-height, navbar floats transparently on top -->
    <section
      class="relative h-screen overflow-hidden"
      id="hero-section"
      data-nav-theme="dark"
    >
      <!-- Scaled background image (GSAP parallax) -->
      <img
        id="hero-bg"
        src="/images/hero-section-image.png"
        alt="Hero Background"
        class="absolute inset-0 w-full h-full object-cover lg:scale-[1.12] -z-10 will-change-transform transform-gpu"
      />

      <div
        class="relative z-10 h-full flex flex-col px-[20px] lg:px-[30px]"
        data-reveal-group
      >
        <!-- Heading -->
        <h1
          data-reveal-title
          class="font-heading text-white font-medium tracking-[-0.03em] leading-[1.16] md:leading-[1.24] text-[43px] md:text-[44px] lg:text-[72px] mt-[115px] md:mt-[245px] lg:mt-[214px]"
        >
          A Legacy of <br class="md:hidden" />Building. <br
            class="hidden lg:block"
          />A New <br class="md:hidden" />Chapter <br
            class="hidden md:block lg:hidden"
          />in Living.
        </h1>
        <!-- Two CTA buttons -->
        <div
          data-reveal-text
          class="flex items-center gap-[14px] lg:gap-[28px] mt-[40px] lg:mt-[36px]"
        >
          <!-- Primary CTA: white pill with dark circle arrow -->
          <a
            href={featuredProjectSlug
              ? `/projects/${featuredProjectSlug}`
              : "/projects/serene-meadows"}
            class="inline-flex no-underline items-center gap-[10px] lg:gap-[14px] bg-white text-[var(--color-navy)] rounded-full h-[50px] lg:h-[55px] pl-5 lg:pl-6 pr-2 font-medium text-[14px] lg:text-[15px] hover:bg-[var(--color-yellow)] transition-colors group whitespace-nowrap"
          >
            Explore {displayFeatured.title}
            <span
              class="w-[34px] h-[34px] lg:w-[38px] lg:h-[38px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center flex-shrink-0 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                  points="12 5 19 12 12 19"></polyline></svg
              >
            </span>
          </a>
          <!-- Secondary CTA: underlined text link -->
          <a
            href="#legacy"
            class="text-white text-[13px] lg:text-[16px] font-normal underline underline-offset-4 decoration-white/60 hover:text-[var(--color-yellow)] hover:decoration-[var(--color-yellow)] transition-colors whitespace-nowrap"
          >
            View Projects
          </a>
        </div>

        <!-- Bottom strip: paragraph (left) + stats panel flush bottom-right -->
        <div
          class="mt-auto w-full flex flex-col lg:flex-row lg:items-end lg:justify-between"
        >
          <p
            data-reveal-text
            class="text-white/85 text-[13px] md:text-[15px] lg:text-[16px] leading-[2.05] md:leading-[1.87] lg:leading-[1.8] max-w-[730px] font-normal pb-[50px] lg:pb-[45px] lg:pr-10"
          >
            For over 50 years, our work has helped shape residential
            developments across Goa. Today, Hindustan Constructions brings that
            experience to projects of its own homes created with quality, care
            and a clear understanding of how families live.
          </p>
          <!-- Stats panel: navy glass, flush bottom; flush right on desktop -->
          <div
            data-reveal-card
            class="flex items-stretch -mx-[20px] lg:mx-0 lg:-mr-[30px] flex-shrink-0 bg-black/20 backdrop-blur-lg border-t border-l border-r lg:border-r-0 border-white/15 rounded-t-[16px] lg:rounded-tr-none h-[114px] lg:h-[154px]"
          >
            <div
              class="flex-1 lg:flex-none lg:w-[175px] flex flex-col items-center justify-center"
            >
              <div
                data-counter
                class="text-white font-light text-[26px] lg:text-[38px] leading-none tracking-tight"
              >
                100+
              </div>
              <div
                class="text-white/80 text-[12px] lg:text-[13px] mt-[10px] lg:mt-[16px] text-center"
              >
                <span class="lg:hidden">Project Completed</span><span
                  class="hidden lg:inline">Projects Completed</span
                >
              </div>
            </div>
            <div class="w-px self-stretch bg-white/15"></div>
            <div
              class="flex-1 lg:flex-none lg:w-[175px] flex flex-col items-center justify-center"
            >
              <div
                data-counter
                class="text-white font-light text-[26px] lg:text-[38px] leading-none tracking-tight"
              >
                50+
              </div>
              <div
                class="text-white/80 text-[12px] lg:text-[13px] mt-[10px] lg:mt-[16px] text-center"
              >
                Years Experience
              </div>
            </div>
            <div class="w-px self-stretch bg-white/15"></div>
            <div
              class="flex-1 lg:flex-none lg:w-[175px] flex flex-col items-center justify-center"
            >
              <div
                data-counter
                class="text-white font-light text-[26px] lg:text-[38px] leading-none tracking-tight"
              >
                98%
              </div>
              <div
                class="text-white/80 text-[12px] lg:text-[13px] mt-[10px] lg:mt-[16px] text-center"
              >
                Client Satisfaction
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section
      id="about"
      class="bg-[var(--color-cream)] min-h-[85vh] flex items-center"
    >
      <div
        class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] py-[72px] lg:py-[48px]"
      >
        <div
          class="flex flex-col lg:grid lg:grid-cols-[600px_minmax(0,1fr)] lg:gap-[28px]"
        >
          <div class="flex flex-col" data-reveal-group>
            <!-- Pill: gray with yellow dot -->
            <div
              data-reveal-text
              class="inline-flex w-fit items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
            >
              <span
                class="w-2 h-2 rounded-full bg-[var(--color-yellow)] flex-shrink-0"
              ></span>
              Our Legacy
            </div>
            <h2
              data-reveal-title
              class="font-heading font-bold text-[#10183B] tracking-[-0.02em] text-[38px] leading-[46px] md:text-[40px] md:leading-[48px] lg:text-[56px] lg:leading-[74px] mt-[16px]"
            >
              Experience You <br class="hidden lg:block" />Can <br
                class="md:hidden"
              />Build a Life On
            </h2>
            <div
              data-reveal-text
              class="text-[#10183B] text-[13px] md:text-[14px] leading-[24px] lg:leading-[26px] mt-[28px] lg:mt-[40px] space-y-[16px] lg:space-y-[20px] max-w-[560px] font-normal"
            >
              <p>
                Before becoming a developer, Hindustan Constructions spent
                decades building for some of Goa's established real-estate
                names. That experience lives in every decision we make today,
                from the strength of the structure and the quality of materials
                to practical planning, thoughtful finishes and dependable
                execution.
              </p>
              <p>
                Our transition from contractor to developer is a natural next
                step: bringing everything we have learned over generations into
                homes that carry our own name and responsibility.
              </p>
            </div>
            <!-- CTA: light pill with navy circle arrow -->
            <a
              data-reveal-btn
              href="#"
              class="inline-flex w-fit no-underline items-center gap-[10px] h-[48px] lg:h-[60px] pl-5 lg:pl-6 pr-[6px] rounded-full bg-[#FFFCF7] border border-[#C9CEDD] text-[#10183B] text-[14px] lg:text-[15px] font-medium mt-[28px] lg:mt-[120px] hover:border-[var(--color-navy)] transition-colors group"
            >
              Discover our Story
              <span
                class="w-[38px] h-[38px] lg:w-[48px] lg:h-[48px] rounded-full bg-[var(--color-navy)] text-white flex items-center justify-center flex-shrink-0 group-hover:bg-[var(--color-yellow)] group-hover:text-[var(--color-navy)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                    points="7 7 17 7 17 17"></polyline></svg
                >
              </span>
            </a>
          </div>
          <div
            class="relative mt-[54px] lg:mt-0 aspect-[354/333] md:aspect-[732/459] lg:aspect-auto lg:min-h-[600px] overflow-hidden rounded-[14px]"
          >
            <img
              data-reveal-img
              src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=80"
              alt="Interior Living Room"
              class="absolute inset-0 w-full h-full object-cover rounded-[14px]"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="pb-20 lg:pb-28 bg-[var(--color-cream)]">
      <div class="max-w-[1280px] mx-auto px-5 md:px-10 lg:px-20">
        <div
          class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5"
          data-reveal-cards
        >
          <div
            data-reveal-card
            class="tilt-card bg-[var(--color-yellow)] rounded-[24px] p-7 lg:p-8"
          >
            <div class="mb-8 text-[var(--color-navy)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
            </div>
            <h3
              class="font-heading font-bold text-[var(--color-navy)] text-lg mb-2 tracking-tight"
            >
              <span data-counter>50+</span> Years
            </h3>
            <p
              class="text-[var(--color-navy)]/65 text-[13px] leading-relaxed font-medium"
            >
              A multi-generational legacy in construction.
            </p>
          </div>

          <div
            data-reveal-card
            class="tilt-card bg-[var(--color-yellow)] rounded-[24px] p-7 lg:p-8"
          >
            <div class="mb-8 text-[var(--color-navy)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
            </div>
            <h3
              class="font-heading font-bold text-[var(--color-navy)] text-lg mb-2 tracking-tight"
            >
              Goa-based
            </h3>
            <p
              class="text-[var(--color-navy)]/65 text-[13px] leading-relaxed font-medium"
            >
              Experience shaped by building across Goa.
            </p>
          </div>

          <div
            data-reveal-card
            class="tilt-card bg-[var(--color-yellow)] rounded-[24px] p-7 lg:p-8"
          >
            <div class="mb-8 text-[var(--color-navy)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="8" r="7"></circle><polyline
                  points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"
                ></polyline></svg
              >
            </div>
            <h3
              class="font-heading font-bold text-[var(--color-navy)] text-lg mb-2 tracking-tight"
            >
              Proven Expertise
            </h3>
            <p
              class="text-[var(--color-navy)]/65 text-[13px] leading-relaxed font-medium"
            >
              Work delivered for established property developers.
            </p>
          </div>

          <div
            data-reveal-card
            class="tilt-card bg-[var(--color-yellow)] rounded-[24px] p-7 lg:p-8"
          >
            <div class="mb-8 text-[var(--color-navy)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                ></path><polyline points="9 22 9 12 15 12 15 22"
                ></polyline></svg
              >
            </div>
            <h3
              class="font-heading font-bold text-[var(--color-navy)] text-lg mb-2 tracking-tight"
            >
              New Chapter
            </h3>
            <p
              class="text-[var(--color-navy)]/65 text-[13px] leading-relaxed font-medium"
            >
              Independent residential developments by Hindustan Constructions.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECT HIGHLIGHT (FEATURED PROJECT) -->
    <section
      class="py-20 lg:py-28 bg-[var(--color-cream)] border-t border-[var(--color-navy)]/8"
    >
      <div class="max-w-[1280px] mx-auto px-5 md:px-10 lg:px-20">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
        >
          <!-- Image LEFT -->
          <div class="order-2 lg:order-1">
            <a
              href={featuredProjectSlug
                ? `/projects/${featuredProjectSlug}`
                : "/projects/serene-meadows"}
              class="block tilt-card h-[460px] lg:h-[620px] w-full relative overflow-hidden rounded-[28px] shadow-2xl group cursor-pointer"
            >
              <img
                data-reveal-img
                src={featuredProject?.coverImage ||
                  "/images/projects/serene-meadows/View 01 v03.png"}
                alt={displayFeatured.title}
                class="w-full h-full object-cover rounded-[28px] group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </a>
            <div
              class="mt-5 flex items-center gap-2 text-[var(--color-gray)] text-[13px] font-semibold tracking-wide"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
              {displayFeatured.location}
            </div>
          </div>

          <!-- Content RIGHT -->
          <div class="order-1 lg:order-2" data-reveal-group>
            <div
              data-reveal-text
              class="inline-flex items-center bg-[var(--color-navy)]/6 rounded-full px-4 py-1.5 text-[10px] font-bold text-[var(--color-navy)] mb-7 uppercase tracking-[0.18em]"
            >
              Featured Project
            </div>
            <h2
              data-reveal-title
              class="font-heading text-[42px] md:text-5xl lg:text-[58px] font-bold text-[var(--color-navy)] mb-6 tracking-tight leading-[1.05]"
            >
              <a
                href={featuredProjectSlug
                  ? `/projects/${featuredProjectSlug}`
                  : "/projects/serene-meadows"}
                class="no-underline text-inherit hover:text-[var(--color-navy-mid)] transition-colors"
              >
                {displayFeatured.title}
              </a>
            </h2>
            <p
              data-reveal-text
              class="text-[var(--color-gray)] text-[14px] leading-[1.85] max-w-[460px] mb-10"
            >
              {displayFeatured.subtitle}
            </p>

            <div
              class="grid grid-cols-2 gap-y-8 gap-x-6 mb-10"
              data-reveal-card
            >
              {
                displayFeatured.details.map((detail) => (
                  <div class="border-l-2 border-[var(--color-navy)]/12 pl-4">
                    <div class="font-heading font-bold text-[var(--color-navy)] text-xl lg:text-[22px] mb-0.5 tracking-tight">
                      {detail.value}
                    </div>
                    <div class="text-[var(--color-gray)] text-[11px] font-semibold tracking-wide uppercase">
                      {detail.key}
                    </div>
                  </div>
                ))
              }
            </div>

            <a
              data-reveal-btn
              href={featuredProjectSlug
                ? `/projects/${featuredProjectSlug}`
                : "/projects/serene-meadows"}
              class="inline-flex no-underline items-center gap-3 bg-[var(--color-navy)] text-white rounded-full px-7 py-3.5 font-bold text-sm hover:bg-[var(--color-yellow)] hover:text-[var(--color-navy)] transition-colors group"
            >
              Explore Project
              <span
                class="w-7 h-7 no-underline rounded-full bg-white/15 text-white flex items-center justify-center text-sm group-hover:bg-[var(--color-navy)] group-hover:text-white transition-colors"
                >→</span
              >
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- GOA MAP -->
    <section
      id="goa-map-section"
      class="relative bg-[var(--color-cream)] min-h-screen overflow-hidden flex flex-col lg:justify-center"
    >
      <!-- Map image: full-bleed background -->
      <div
        class="relative order-2 lg:order-none lg:absolute lg:inset-0 mt-[40px] lg:mt-0"
      >
        <img
          id="goa-map-img"
          src="/images/map-image.png"
          alt="Map of North Goa"
          class="w-full h-auto lg:w-full lg:h-full object-cover object-right lg:object-[right_center] block will-change-transform transform-gpu"
          loading="lazy"
        />
      </div>
      <!-- Text -->
      <div
        data-reveal-group
        class="relative z-10 order-1 w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px] pt-[72px] lg:pt-0"
      >
        <h2
          data-reveal-title
          class="font-heading font-bold text-[#10183B] tracking-[-0.02em] text-[32px] leading-[34px] md:text-[42px] md:leading-[64px] lg:text-[56px] lg:leading-[66px]"
        >
          The Best of Goa,<br />Close to Home
        </h2>
        <p
          data-reveal-text
          class="text-[#10183B] text-[13px] lg:text-[14px] leading-[24px] lg:leading-[26px] mt-[14px] md:mt-[18px] lg:mt-[16px] md:max-w-[560px] lg:max-w-[430px]"
        >
          From Assagao to Kadamba Plateau, our featured projects are shaped by
          thoughtful design, enduring quality, and a strong connection to their
          surroundings.
        </p>
      </div>
    </section>

    <!-- EXPERIENCE (BENTO GRID) -->
    <section
      id="legacy"
      class="bg-[var(--color-cream)] min-h-screen flex flex-col justify-center py-[72px] lg:py-[48px]"
    >
      <div class="w-full max-w-[1440px] mx-auto px-[18px] lg:px-[60px]">
        <!-- Section header: centered pill + heading -->
        <div class="flex flex-col items-center text-center" data-reveal-group>
          <div
            data-reveal-text
            class="inline-flex items-center gap-[10px] h-[46px] px-[20px] rounded-full bg-[#A9A8AC] text-[#F4F1ED] text-[12px] font-medium"
          >
            <span
              class="w-2 h-2 rounded-full bg-[var(--color-yellow)] flex-shrink-0"
            ></span>
            Why us
          </div>
          <h2
            data-reveal-title
            class="mt-[16px] font-heading font-bold text-[#10183B] tracking-[-0.02em] text-[34px] leading-[44px] md:text-[40px] md:leading-[46px] lg:text-[56px] lg:leading-[66px]"
          >
            Build<span class="hidden lg:inline">t</span> with Experience<span
              class="hidden lg:inline">.</span
            ><br />Guided by <br class="md:hidden" />Responsibility<span
              class="hidden lg:inline">.</span
            >
          </h2>
        </div>

        <!-- Bento cards -->
        <div
          data-reveal-cards
          class="mt-[40px] lg:mt-[48px] flex flex-col lg:flex-row gap-[18px] md:max-w-[553px] md:mx-auto lg:max-w-none"
        >
          <!-- Left column -->
          <div class="lg:w-[65%] flex flex-col gap-[18px]">
            <!-- Navy stat card -->
