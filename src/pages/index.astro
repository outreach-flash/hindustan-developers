---
export const prerender = true;
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const reader = createReader(process.cwd(), keystaticConfig);
let featuredProject = null;
let featuredProjectSlug = null;

try {
  const featured = await reader.singletons.featuredProject.read();
  if (featured?.projectSlug) {
    featuredProject = await reader.collections.projects.read(
      featured.projectSlug,
    );
    featuredProjectSlug = featuredProject ? featured.projectSlug : null;
  }
} catch (error) {}

const defaultFeatured = {
  title: "Serene Meadows",
  subtitle:
    "Serene Meadows is a thoughtfully designed residential development offering modern homes with world-class amenities in a serene and well-connected location, just behind Sunshine School, Kadamba Plateau.",
  location: "Kadamba Plateau, Goa",
  details: [
    { key: "Swimming Pool", value: "Yes" },
    { key: "Fully Equipped Gym", value: "Yes" },
    { key: "Clubhouse", value: "Party Hall" },
    { key: "Security", value: "Round the Clock" },
  ],
};

const displayFeatured = featuredProject || defaultFeatured;

// Map the details for the grid display
const projectAmenities = displayFeatured.details.slice(0, 4);
---

<Layout>
  <Navbar slot="navbar" variant="overlay" />

  <main class="text-[#1a1c1a] bg-[#1a1c1a]">
    <!-- HERO SECTION -->
    <section
      class="relative h-screen min-h-[800px] flex flex-col justify-end pb-10 lg:pb-16 pt-32 overflow-hidden"
      data-reveal-group
      data-nav-theme="dark"
    >
      <img
        src={encodeURI("/images/projects/serene-meadows/View 07 v02.webp")}
        alt="Serene Meadows Poolside Oasis"
        class="absolute left-0 w-full h-[130%] top-[-15%] object-cover object-center"
        data-speed="0.6"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#1a1c1a] via-[#1a1c1a]/50 to-black/35"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#1a1c1a]/80 via-[#1a1c1a]/30 to-transparent"
      >
      </div>

      <div
        class="relative z-10 w-full max-w-[1440px] mx-auto px-6 lg:px-16 flex flex-col lg:flex-row lg:items-end justify-between gap-12"
      >
        <div class="max-w-3xl">
          <h1
            class="font-serif text-5xl md:text-7xl lg:text-[84px] text-white leading-[1.05] tracking-tight mb-8"
            data-reveal-item
          >
            Building<br />Exceptional<br />Lives in <span class="text-[#c7a469]"
              >Goa</span
            >
          </h1>
          <p
            class="text-white text-xl md:text-2xl font-light tracking-wide mb-6"
            data-reveal-item
          >
            Building Trust. Creating Spaces. <br /> Shaping Tomorrow.
          </p>
          <p
            class="text-white/80 text-base md:text-lg max-w-xl mb-12 leading-relaxed font-light"
            data-reveal-item
          >
            Hindustan Developers creates thoughtfully designed residences in
            Goa's most desirable locations, combining elegance, quality and long
            term value.
          </p>

          <div class="flex flex-col sm:flex-row gap-5" data-reveal-item>
            <a
              href="/projects"
              class="inline-flex items-center justify-center gap-3 bg-[#c7a469] text-[#1a1c1a] font-bold text-[12px] tracking-[0.15em] uppercase px-8 py-4 hover:bg-[#b49157] transition-colors"
            >
              EXPLORE PROJECTS &rarr;
            </a>
            <a
              href="#purpose"
              class="inline-flex items-center justify-center gap-3 border border-white/50 text-white font-bold text-[12px] tracking-[0.15em] uppercase px-8 py-4 hover:bg-white/10 transition-colors"
            >
              KNOW MORE
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- OUR PURPOSE / MISSION / VISION -->
    <section
      id="purpose"
      class="flex flex-col lg:flex-row w-full min-h-screen"
      data-reveal-group
      data-nav-theme="light"
    >
      <!-- Left side (Purpose) -->
      <div class="w-full lg:w-7/12 bg-[#f5f3ee] flex justify-end">
        <div
          class="w-full max-w-[760px] px-6 lg:pl-16 lg:pr-20 xl:pr-28 py-20 lg:py-32 flex flex-col justify-center"
        >
          <div
            class="text-[#c7a469] text-sm font-bold tracking-[0.2em] uppercase mb-6"
            data-reveal-item
          >
            Our Purpose
          </div>
          <h2
            class="font-serif text-5xl lg:text-[64px] leading-[1.1] tracking-tight text-[#1a1c1a] mb-8"
            data-reveal-item
          >
            Building Legacies<br />for Generations
          </h2>
          <p
            class="text-[#1a1c1a]/75 text-lg leading-[1.8] mb-20 max-w-lg"
            data-reveal-item
